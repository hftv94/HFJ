// الوحدات: إشارات الاتجاه (▲ / ▲+) + علامات TP ✓ + Trailing TP | خطوط الاتجاه | ORB | السيولة | RMI | Volume Screener | إدارة رأس المال | كتل الأوامر
//@version=6
indicator("HFJ Pro Suite", shorttitle = "HFJ Pro", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// ════════════════════════════════════════════════════════════
// 0. الثوابت والأنواع
// ════════════════════════════════════════════════════════════
const string G_MOD  = "MODULES"
const string G_SIG  = "TREND SIGNAL SETTINGS"
const string G_LIQ  = "LIQUIDITY SETTINGS"
const string G_ORB  = "ORB SETTINGS"
const string G_TL   = "TRENDLINES SETTINGS"
const string G_OB   = "ORDERBLOCK SETTINGS"
const string G_RMI  = "RMI SETTINGS"
const string G_RISK = "CAPITAL RISK SETTINGS"
const string G_VOL  = "VOLUME SCREENER"
const string G_SYM  = "SYMBOLS"

const color C_UP    = #26C6B0 // تركوازي (صاعد)
const color C_DN    = #F23645 // أحمر (هابط)
const color C_TP    = #4CAF50 // علامة الهدف ✓
const color C_SL    = #FFD600
const color C_TXT   = #FFFFFF
const color C_DOT   = #2962FF // دوائر مستويات ORB
const color C_BSL   = #F23645
const color C_SSL   = #089981
const color C_SWEPT = #787B86
const color C_OB_UP = #00BFA5
const color C_OB_DN = #FF5252
const color C_BRK   = #FF9800

type Liq
    line  ln
    label lb
    float px
    int   dir          // 1 = سيولة قمة، -1 = سيولة قاع
    bool  done = false

type TLine
    line  ln
    int   x1
    float y1
    float slope
    int   dir          // -1 = مقاومة هابطة، 1 = دعم صاعد

type OB
    box   bx
    float top
    float bot
    int   dir          // 1 = شرائية، -1 = بيعية
    bool  breaker = false

type OrbSet
    int          x1
    line         hi
    line         mid
    line         lo
    box          up
    box          dn
    array<label> dots

// ════════════════════════════════════════════════════════════
// 1. المدخلات
// ════════════════════════════════════════════════════════════
// --- الوحدات ---
bool m_sig  = input.bool(true,  "Trend Signals",   group = G_MOD)
bool m_tl   = input.bool(false, "TrendLines",      inline = "m1", group = G_MOD)
bool m_orb  = input.bool(true,  "ORB",             inline = "m1", group = G_MOD)
bool m_liq  = input.bool(true,  "Liquidity",       inline = "m1", group = G_MOD)
bool m_rmi  = input.bool(false, "RMI Trend",       inline = "m2", group = G_MOD)
bool m_vol  = input.bool(false, "Volume Screener", inline = "m2", group = G_MOD)
bool m_risk = input.bool(false, "Capital Risk",    inline = "m2", group = G_MOD)
bool m_ob   = input.bool(false, "Order Blocks",    inline = "m3", group = G_MOD)
bool m_dash = input.bool(true,  "Dashboard",       inline = "m3", group = G_MOD)

// --- إشارات الاتجاه ---
float s_sens    = input.float(1.7, "Sensitivity", minval = 0.5, maxval = 10.0, step = 0.1, inline = "s1", group = G_SIG, tooltip = "معامل ATR لمحرك الاتجاه. أقل = إشارات أكثر، أعلى = إشارات أقل وأقوى")
bool  s_tp      = input.bool(true, "TP", inline = "s1", group = G_SIG, tooltip = "علامة ✓ عند تشبع الحركة (مكان مناسب لجني الربح)")
bool  s_candles = input.bool(true, "Trend Candles", group = G_SIG)
bool  s_trail   = input.bool(true, "Trailing TP", inline = "s2", group = G_SIG)
float s_trailR  = input.float(2.1, "", minval = 0.5, step = 0.1, inline = "s2", group = G_SIG, tooltip = "مسافة خط الوقف المتحرك بمضاعفات ATR. ينتهي الخط عند إغلاق السعر خلفه")
bool  s_levels  = input.bool(false, "TP Levels (1R / 2R / 3R)", group = G_SIG, tooltip = "رسم الدخول والوقف وثلاثة أهداف عند كل إشارة")
int   s_atrLen  = input.int(10, "ATR Length", minval = 1, group = G_SIG)
bool  s_confirm = input.bool(true, "Confirm on bar close", group = G_SIG, tooltip = "يمنع ظهور واختفاء الإشارات أثناء تكوّن الشمعة")

// --- السيولة ---
int l_len = input.int(5,  "Length", minval = 2, maxval = 50, inline = "l1", group = G_LIQ)
int l_max = input.int(10, "Max",    minval = 1, maxval = 50, inline = "l1", group = G_LIQ)
int l_ext = input.int(5,  "Extend", minval = 1, maxval = 100, group = G_LIQ)

// --- ORB ---
int    o_utc  = input.int(3, "+/- UTC", minval = -12, maxval = 14, group = G_ORB, tooltip = "فرق التوقيت عن UTC للجلسة. فوركس: لندن 0800-0830 (UTC+0)، نيويورك 0930-1000 (UTC-4 صيفاً)")
string o_sess = input.session("0945-1015", "Session", inline = "o1", group = G_ORB)
color  o_colU = input.color(#1E3A5F99, "", inline = "o1", group = G_ORB)
color  o_colD = input.color(#5D2E0C99, "", inline = "o1", group = G_ORB)
bool   o_sig  = input.bool(true, "Signals", group = G_ORB)
int    o_days = input.int(3, "Days to show", minval = 1, maxval = 10, group = G_ORB)

// --- خطوط الاتجاه ---
string t_sens = input.string("Medium", "", options = ["Small", "Medium", "Large"], inline = "t1", group = G_TL)
color  t_col  = input.color(color.gray, "", inline = "t1", group = G_TL)
int    t_last = input.int(2, "Last", minval = 1, maxval = 10, inline = "t1", group = G_TL)
bool   t_hist = input.bool(false, "History", group = G_TL, tooltip = "إبقاء خطوط الاتجاه المكسورة على الشارت")

// --- كتل الأوامر ---
string ob_preset  = input.string("Macro", "Preset", options = ["Micro", "Swing", "Macro"], inline = "b1", group = G_OB)
bool   ob_breaker = input.bool(false, "Breaker Block", inline = "b1", group = G_OB)
int    ob_max     = input.int(5, "Max blocks per side", minval = 1, maxval = 20, group = G_OB)

// --- RMI ---
int   r_len   = input.int(14, "RMI Length", minval = 2, group = G_RMI)
float r_pos   = input.float(66, "Positive above", minval = 50, maxval = 100, group = G_RMI)
float r_neg   = input.float(30, "Negative below", minval = 0, maxval = 50, group = G_RMI)
bool  r_ma    = input.bool(true, "Show MA", inline = "r1", group = G_RMI)
color r_colUp = input.color(#00BCD4, "", inline = "r1", group = G_RMI)
color r_colDn = input.color(#FF5252, "", inline = "r1", group = G_RMI)

// --- إدارة رأس المال ---
float  c_cap  = input.float(100000, "Capital", minval = 1, group = G_RISK)
float  c_risk = input.float(2, "% Account Risk", minval = 0.01, maxval = 100, step = 0.1, group = G_RISK)
float  c_sl   = input.float(3, "% Stop Loss", minval = 0.01, maxval = 100, step = 0.1, group = G_RISK)
float  c_rr   = input.float(2, "RR Ratio", minval = 0.1, step = 0.1, group = G_RISK)
string c_cur  = input.string("USD", "Account currency", group = G_RISK, tooltip = "عملة رأس المال (USD, EUR, EGP, SAR...). التحويل من عملة الرمز تلقائي")

// --- Volume Screener ---
int    v_len  = input.int(14, "Length", minval = 2, group = G_VOL, tooltip = "فترة متوسط الحجم (RVOL) و RSI في الجدول")
string v_size = input.string("صغير", "Size", options = ["صغير", "متوسط", "كبير"], inline = "v1", group = G_VOL)
string v_pos  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Left", "Middle Right"], inline = "v1", group = G_VOL)
float  v_mult = input.float(2.0, "Spike ×", minval = 1.0, step = 0.1, group = G_VOL, tooltip = "تمييز الشمعة على الشارت إذا كان حجمها أكبر من المتوسط بهذا المعامل")
bool   v_vwap = input.bool(false, "Show VWAP", group = G_VOL)

bool   on1  = input.bool(true, "Symbol 1",  inline = "y1",  group = G_SYM)
string sym1 = input.symbol("OANDA:EURUSD", "", inline = "y1", group = G_SYM)
bool   on2  = input.bool(true, "Symbol 2",  inline = "y2",  group = G_SYM)
string sym2 = input.symbol("OANDA:GBPUSD", "", inline = "y2", group = G_SYM)
bool   on3  = input.bool(true, "Symbol 3",  inline = "y3",  group = G_SYM)
string sym3 = input.symbol("OANDA:USDJPY", "", inline = "y3", group = G_SYM)
bool   on4  = input.bool(true, "Symbol 4",  inline = "y4",  group = G_SYM)
string sym4 = input.symbol("OANDA:XAUUSD", "", inline = "y4", group = G_SYM)
bool   on5  = input.bool(true, "Symbol 5",  inline = "y5",  group = G_SYM)
string sym5 = input.symbol("BITSTAMP:BTCUSD", "", inline = "y5", group = G_SYM)
bool   on6  = input.bool(true, "Symbol 6",  inline = "y6",  group = G_SYM)
string sym6 = input.symbol("BITSTAMP:ETHUSD", "", inline = "y6", group = G_SYM)
bool   on7  = input.bool(true, "Symbol 7",  inline = "y7",  group = G_SYM)
string sym7 = input.symbol("OANDA:AUDUSD", "", inline = "y7", group = G_SYM)
bool   on8  = input.bool(true, "Symbol 8",  inline = "y8",  group = G_SYM)
string sym8 = input.symbol("OANDA:USDCAD", "", inline = "y8", group = G_SYM)
bool   on9  = input.bool(true, "Symbol 9",  inline = "y9",  group = G_SYM)
string sym9 = input.symbol("OANDA:USDCHF", "", inline = "y9", group = G_SYM)
bool   on10 = input.bool(true, "Symbol 10", inline = "y10", group = G_SYM)
string sym10 = input.symbol("OANDA:XAGUSD", "", inline = "y10", group = G_SYM)

// ════════════════════════════════════════════════════════════
// 2. الحسابات العامة (كل دوال ta.* في النطاق العام)
// ════════════════════════════════════════════════════════════
float atr14   = ta.atr(14)
float ema200  = ta.ema(close, 200)
float rsi14   = ta.rsi(close, 14)
float ema5Chg = ta.change(ta.ema(close, 5))
bool  barOk   = not s_confirm or barstate.isconfirmed
bool  conf    = barstate.isconfirmed
bool  rsiDnX  = ta.crossunder(rsi14, 70)
bool  rsiUpX  = ta.crossover(rsi14, 30)

[stLine, stDir] = ta.supertrend(s_sens, s_atrLen)
int trend = stDir < 0 ? 1 : -1

// الحجم (بعض أزواج الفوركس بدون حجم — الوحدات تتعامل مع ذلك تلقائياً)
float vol    = nz(volume)
bool  hasVol = ta.cum(vol) > 0
float vAvg   = ta.sma(vol, v_len)
float rvol   = vAvg > 0 ? vol / vAvg : na
float vwapV  = ta.vwap(hlc3)

// RMI = متوسط RSI و MFI (أو RSI فقط إذا لم يتوفر حجم)
float rsiR  = ta.rsi(close, r_len)
float mfiR  = ta.mfi(hlc3, r_len)
float rmi   = hasVol and not na(mfiR) ? (rsiR + mfiR) / 2 : rsiR
float rmiMa = ta.ema(close, r_len)

// محاور الوحدات
int   t_len  = t_sens == "Small" ? 5 : t_sens == "Medium" ? 10 : 20
int   ob_len = ob_preset == "Micro" ? 5 : ob_preset == "Swing" ? 10 : 20
float liqPh  = ta.pivothigh(high, l_len, l_len)
float liqPl  = ta.pivotlow(low, l_len, l_len)
float tlPh   = ta.pivothigh(high, t_len, t_len)
float tlPl   = ta.pivotlow(low, t_len, t_len)
float obPh   = ta.pivothigh(high, ob_len, ob_len)
float obPl   = ta.pivotlow(low, ob_len, ob_len)

// ORB
string o_tz   = "UTC" + (o_utc >= 0 ? "+" : "-") + str.tostring(math.abs(o_utc))
bool   inOrb  = m_orb and timeframe.isintraday and not na(time(timeframe.period, o_sess, o_tz))
bool   newDay = ta.change(dayofmonth(time, o_tz)) != 0

// تحويل عملة الرمز إلى عملة الحساب
float fxRate = request.currency_rate(syminfo.currency, c_cur, ignore_invalid_currency = true)

// ════════════════════════════════════════════════════════════
// 3. إشارات الاتجاه (▲ / ▲+ / ▼ / ▼+)
// ════════════════════════════════════════════════════════════
var int sigState = 0
bool buySig  = m_sig and barOk and bar_index > s_atrLen and trend == 1 and sigState != 1
bool sellSig = m_sig and barOk and bar_index > s_atrLen and trend == -1 and sigState != -1
if buySig
    sigState := 1
if sellSig
    sigState := -1

// "+" = الإشارة مع اتجاه EMA 200 (أقوى)
bool strongBuy  = buySig and close > ema200
bool strongSell = sellSig and close < ema200
float sigOff    = nz(atr14) * 0.8

plotshape(buySig and not strongBuy ? low - sigOff : na, "Buy Label", shape.labelup, location.absolute, C_UP, text = "▲", textcolor = C_TXT, size = size.small)
plotshape(strongBuy ? low - sigOff : na, "Buy Label +", shape.labelup, location.absolute, C_UP, text = "▲+", textcolor = C_TXT, size = size.small)
plotshape(sellSig and not strongSell ? high + sigOff : na, "Sell Label", shape.labeldown, location.absolute, C_DN, text = "▼", textcolor = C_TXT, size = size.small)
plotshape(strongSell ? high + sigOff : na, "Sell Label +", shape.labeldown, location.absolute, C_DN, text = "▼+", textcolor = C_TXT, size = size.small)

// علامات TP ✓: تشبع RSI في اتجاه الصفقة
bool tpLong  = m_sig and s_tp and barOk and sigState == 1 and rsiDnX
bool tpShort = m_sig and s_tp and barOk and sigState == -1 and rsiUpX
plotchar(tpLong, "TP Long", "✓", location.abovebar, C_TP, size = size.small)
plotchar(tpShort, "TP Short", "✓", location.belowbar, C_TP, size = size.small)

// الشموع
color candleCol = trend == 1 ? C_UP : C_DN
bool  showCnd   = m_sig and s_candles
plotcandle(showCnd ? open : na, showCnd ? high : na, showCnd ? low : na, showCnd ? close : na, "PlotCandle", color = candleCol, wickcolor = candleCol, bordercolor = candleCol)
barcolor(showCnd ? candleCol : na, title = "Bar Color")

// ════════════════════════════════════════════════════════════
// 4. Trailing TP + مستويات الأهداف
// ════════════════════════════════════════════════════════════
var int   tDir      = 0
var float tEntry    = na
var float tSL       = na
var float tRisk     = na
var int   tpHit     = 0
var float trail     = na
var bool  trailLive = false
var array<line>  tpLines  = array.new<line>()
var array<label> tpLabels = array.new<label>()

f_tpPrice(int k) =>
    tEntry + tDir * tRisk * k

bool trailExit = false
bool tpHitNow  = false
bool newSig    = buySig or sellSig

if newSig
    while tpLines.size() > 0
        tpLines.pop().delete()
    while tpLabels.size() > 0
        tpLabels.pop().delete()
    tDir      := buySig ? 1 : -1
    tEntry    := close
    tSL       := stLine
    tRisk     := math.max(math.abs(close - stLine), nz(atr14) * 0.25, syminfo.mintick)
    tpHit     := 0
    trail     := na
    trailLive := s_trail
    if s_levels
        int x2 = bar_index + 10
        color tc = tDir == 1 ? C_UP : C_DN
        tpLines.push(line.new(bar_index, tSL, x2, tSL, color = C_SL, style = line.style_dashed))
        tpLabels.push(label.new(x2, tSL, "SL " + str.tostring(tSL, format.mintick), style = label.style_label_left, color = C_SL, textcolor = color.black, size = size.tiny))
        tpLines.push(line.new(bar_index, tEntry, x2, tEntry, color = color.new(C_TXT, 50), style = line.style_dotted))
        tpLabels.push(label.new(x2, tEntry, "Entry " + str.tostring(tEntry, format.mintick), style = label.style_label_left, color = color.new(C_TXT, 70), textcolor = color.black, size = size.tiny))
        for k = 1 to 3
            float p = f_tpPrice(k)
            tpLines.push(line.new(bar_index, p, x2, p, color = tc, style = line.style_dashed))
            tpLabels.push(label.new(x2, p, "TP" + str.tostring(k) + " " + str.tostring(p, format.mintick), style = label.style_label_left, color = tc, textcolor = C_TXT, size = size.tiny))
else if tDir != 0
    for k = 1 to 3
        float p = f_tpPrice(k)
        if tpHit < k and (tDir == 1 ? high >= p : low <= p)
            tpHit    := k
            tpHitNow := true
            if s_levels and tpLabels.size() == 5
                tpLabels.get(k + 1).set_text("TP" + str.tostring(k) + " ✓ " + str.tostring(p, format.mintick))
    if s_levels
        int x2 = bar_index + 10
        for ln in tpLines
            ln.set_x2(x2)
        for lb in tpLabels
            lb.set_x(x2)

// الوقف المتحرك: يتبع السعر بمسافة ATR × Trailing TP ولا يرجع للخلف
if trailLive and tDir != 0
    float cand = close - tDir * s_trailR * nz(atr14)
    trail := na(trail) ? cand : tDir == 1 ? math.max(trail, cand) : math.min(trail, cand)
    if not newSig and barOk and (tDir == 1 ? close < trail : close > trail)
        trailLive := false
        trailExit := true

bool showTrail = m_sig and s_trail and (trailLive or trailExit)
plot(showTrail and tDir == 1 ? trail : na, "Up Trend", color = C_TP, linewidth = 2, style = plot.style_steplinebr)
plot(showTrail and tDir == -1 ? trail : na, "Down Trend", color = C_DN, linewidth = 2, style = plot.style_steplinebr)

// ════════════════════════════════════════════════════════════
// 5. السيولة (BSL / SSL + Sweep)
// ════════════════════════════════════════════════════════════
var array<Liq> liqs = array.new<Liq>()
bool liqSweepUp = false
bool liqSweepDn = false

if m_liq and conf
    if not na(liqPh)
        int x1 = bar_index - l_len
        line ln = line.new(x1, liqPh, bar_index + l_ext, liqPh, color = C_BSL, width = 1, style = line.style_dashed)
        label lb = label.new(x1, liqPh, "BSL", style = label.style_label_lower_right, color = color.new(C_BSL, 100), textcolor = C_BSL, size = size.tiny)
        liqs.push(Liq.new(ln, lb, liqPh, 1))
    if not na(liqPl)
        int x1 = bar_index - l_len
        line ln = line.new(x1, liqPl, bar_index + l_ext, liqPl, color = C_SSL, width = 1, style = line.style_dashed)
        label lb = label.new(x1, liqPl, "SSL", style = label.style_label_upper_right, color = color.new(C_SSL, 100), textcolor = C_SSL, size = size.tiny)
        liqs.push(Liq.new(ln, lb, liqPl, -1))
    while liqs.size() > l_max
        Liq old = liqs.shift()
        old.ln.delete()
        old.lb.delete()
    for z in liqs
        if not z.done
            bool touched = z.dir == 1 ? high > z.px : low < z.px
            if touched
                bool sweep = z.dir == 1 ? close < z.px : close > z.px // ذيل اخترق وأغلق عائداً = اصطياد
                z.done := true
                z.ln.set_x2(bar_index)
                z.ln.set_color(sweep ? (z.dir == 1 ? C_BSL : C_SSL) : C_SWEPT)
                z.ln.set_style(line.style_solid)
                if sweep
                    liqSweepUp := liqSweepUp or z.dir == 1
                    liqSweepDn := liqSweepDn or z.dir == -1
                    label.new(bar_index, z.px, "x", style = label.style_none, textcolor = z.dir == 1 ? C_BSL : C_SSL, size = size.normal)
            else
                z.ln.set_x2(bar_index + l_ext)

// ════════════════════════════════════════════════════════════
// 6. نطاق الافتتاح ORB (صندوق متدرج + 3 مستويات بدوائر)
// ════════════════════════════════════════════════════════════
var array<OrbSet> orbs = array.new<OrbSet>()
var float orbHi     = na
var float orbLo     = na
var bool  orbReady  = false
var bool  orbLive   = false
var bool  orbUpDone = false
var bool  orbDnDone = false

bool orbStart = inOrb and not inOrb[1]
bool orbEnd   = not inOrb and inOrb[1]

f_orbDot(int x, float y) =>
    label.new(x, y, "◯", style = label.style_none, textcolor = C_DOT, size = size.small)

f_orbDelete(OrbSet o) =>
    o.hi.delete()
    o.mid.delete()
    o.lo.delete()
    o.up.delete()
    o.dn.delete()
    for d in o.dots
        d.delete()
    true

f_orbDraw(OrbSet o, int x2, float h, float l, bool forming) =>
    float m  = (h + l) / 2
    int   xm = math.round((o.x1 + x2) / 2)
    o.hi.set_xy1(o.x1, h)
    o.hi.set_xy2(x2, h)
    o.mid.set_xy1(o.x1, m)
    o.mid.set_xy2(x2, m)
    o.lo.set_xy1(o.x1, l)
    o.lo.set_xy2(x2, l)
    o.up.set_lefttop(o.x1, h)
    o.up.set_rightbottom(forming ? bar_index : o.up.get_right(), m)
    o.dn.set_lefttop(o.x1, m)
    o.dn.set_rightbottom(forming ? bar_index : o.dn.get_right(), l)
    array<float> ys = array.from(h, m, l)
    for i = 0 to 2
        float y = ys.get(i)
        o.dots.get(i * 3).set_xy(o.x1, y)
        o.dots.get(i * 3 + 1).set_xy(xm, y)
        o.dots.get(i * 3 + 2).set_xy(x2, y)
    true

if newDay and not inOrb
    orbLive := false

if orbStart
    orbHi     := high
    orbLo     := low
    orbReady  := false
    orbLive   := true
    orbUpDone := false
    orbDnDone := false
    color lc = color.new(color.gray, 20)
    array<label> dots = array.new<label>()
    for i = 1 to 9
        dots.push(f_orbDot(bar_index, close))
    OrbSet o = OrbSet.new(bar_index, line.new(bar_index, high, bar_index, high, color = lc), line.new(bar_index, hl2, bar_index, hl2, color = lc), line.new(bar_index, low, bar_index, low, color = lc), box.new(bar_index, high, bar_index, hl2, border_color = na, bgcolor = o_colU), box.new(bar_index, hl2, bar_index, low, border_color = na, bgcolor = o_colD), dots)
    orbs.push(o)
    while orbs.size() > o_days
        f_orbDelete(orbs.shift())
else if inOrb
    orbHi := math.max(orbHi, high)
    orbLo := math.min(orbLo, low)

if orbEnd
    orbReady := true

if orbLive and orbs.size() > 0
    f_orbDraw(orbs.last(), bar_index + 20, orbHi, orbLo, inOrb)

bool orbUp = orbReady and orbLive and not orbUpDone and barOk and close > orbHi
bool orbDn = orbReady and orbLive and not orbDnDone and barOk and close < orbLo
if orbUp
    orbUpDone := true
if orbDn
    orbDnDone := true
if o_sig and orbUp
    label.new(bar_index, na, "", yloc = yloc.belowbar, style = label.style_label_up, color = C_UP, size = size.tiny)
if o_sig and orbDn
    label.new(bar_index, na, "", yloc = yloc.abovebar, style = label.style_label_down, color = C_DN, size = size.tiny)

// ════════════════════════════════════════════════════════════
// 7. خطوط الاتجاه (TrendLines + Break)
// ════════════════════════════════════════════════════════════
var array<TLine> tlRes  = array.new<TLine>()
var array<TLine> tlSup  = array.new<TLine>()
var array<line>  tlHist = array.new<line>()
var float lastPhPx = na
var int   lastPhX  = na
var float lastPlPx = na
var int   lastPlX  = na
bool tlBreakUp = false
bool tlBreakDn = false

f_tlValue(TLine t) =>
    t.y1 + t.slope * (bar_index - t.x1)

f_tlUpdate(array<TLine> arr) =>
    bool broke = false
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            TLine t = arr.get(i)
            float v = f_tlValue(t)
            bool br = t.dir == -1 ? close > v : close < v
            if br
                broke := true
                t.ln.set_xy2(bar_index, v)
                t.ln.set_style(line.style_dotted)
                label.new(bar_index, na, t.dir == -1 ? "Break ▲" : "Break ▼", yloc = t.dir == -1 ? yloc.belowbar : yloc.abovebar, style = t.dir == -1 ? label.style_label_up : label.style_label_down, color = color.new(t_col, 20), textcolor = C_TXT, size = size.tiny)
                if t_hist
                    tlHist.push(t.ln)
                    while tlHist.size() > 20
                        tlHist.shift().delete()
                else
                    t.ln.delete()
                arr.remove(i)
            else
                t.ln.set_xy2(bar_index, v)
    broke

if m_tl and conf
    if not na(tlPh)
        int x2 = bar_index - t_len
        if not na(lastPhPx) and tlPh < lastPhPx and x2 > lastPhX
            float sl = (tlPh - lastPhPx) / (x2 - lastPhX)
            line ln = line.new(lastPhX, lastPhPx, bar_index, tlPh + sl * t_len, color = t_col, width = 2)
            tlRes.push(TLine.new(ln, lastPhX, lastPhPx, sl, -1))
            while tlRes.size() > t_last
                tlRes.shift().ln.delete()
        lastPhPx := tlPh
        lastPhX  := x2
    if not na(tlPl)
        int x2 = bar_index - t_len
        if not na(lastPlPx) and tlPl > lastPlPx and x2 > lastPlX
            float sl = (tlPl - lastPlPx) / (x2 - lastPlX)
            line ln = line.new(lastPlX, lastPlPx, bar_index, tlPl + sl * t_len, color = t_col, width = 2)
            tlSup.push(TLine.new(ln, lastPlX, lastPlPx, sl, 1))
            while tlSup.size() > t_last
                tlSup.shift().ln.delete()
        lastPlPx := tlPl
        lastPlX  := x2
    tlBreakUp := f_tlUpdate(tlRes)
    tlBreakDn := f_tlUpdate(tlSup)

// ════════════════════════════════════════════════════════════
// 8. كتل الأوامر (BOS → Order Block / Breaker)
// ════════════════════════════════════════════════════════════
var array<OB> obs = array.new<OB>()
var float swHi     = na
var int   swHiX    = na
var bool  swHiUsed = true
var float swLo     = na
var int   swLoX    = na
var bool  swLoUsed = true

if not na(obPh)
    swHi     := obPh
    swHiX    := bar_index - ob_len
    swHiUsed := false
if not na(obPl)
    swLo     := obPl
    swLoX    := bar_index - ob_len
    swLoUsed := false

f_obCount(int d) =>
    int n = 0
    for o in obs
        n += o.dir == d and not o.breaker ? 1 : 0
    n

f_obTrim(int d) =>
    // حذف أقدم كتلة من نفس الاتجاه عند تجاوز الحد
    if f_obCount(d) > ob_max
        for i = 0 to obs.size() - 1
            OB o = obs.get(i)
            if o.dir == d and not o.breaker
                o.bx.delete()
                obs.remove(i)
                break
    true

if m_ob and conf
    // كسر هيكل صاعد: الكتلة = أدنى شمعة بين القمة المكسورة والآن
    if not swHiUsed and close > swHi
        swHiUsed := true
        int span = math.min(bar_index - swHiX, 300)
        int idx = 1
        float mn = low[1]
        for i = 1 to span
            if low[i] < mn
                mn  := low[i]
                idx := i
        box b = box.new(bar_index - idx, high[idx], bar_index + 10, low[idx], border_color = color.new(C_OB_UP, 40), bgcolor = color.new(C_OB_UP, 80), text = "Bull OB", text_color = C_OB_UP, text_size = size.tiny, text_halign = text.align_right)
        obs.push(OB.new(b, high[idx], low[idx], 1))
        f_obTrim(1)
    // كسر هيكل هابط: الكتلة = أعلى شمعة بين القاع المكسور والآن
    if not swLoUsed and close < swLo
        swLoUsed := true
        int span = math.min(bar_index - swLoX, 300)
        int idx = 1
        float mx = high[1]
        for i = 1 to span
            if high[i] > mx
                mx  := high[i]
                idx := i
        box b = box.new(bar_index - idx, high[idx], bar_index + 10, low[idx], border_color = color.new(C_OB_DN, 40), bgcolor = color.new(C_OB_DN, 80), text = "Bear OB", text_color = C_OB_DN, text_size = size.tiny, text_halign = text.align_right)
        obs.push(OB.new(b, high[idx], low[idx], -1))
        f_obTrim(-1)
    // تحديث الكتل: كسر ← Breaker أو حذف
    if obs.size() > 0
        for i = obs.size() - 1 to 0
            OB o = obs.get(i)
            bool kill = false
            if not o.breaker
                if o.dir == 1 ? close < o.bot : close > o.top
                    if ob_breaker
                        o.breaker := true
                        o.bx.set_bgcolor(color.new(C_BRK, 85))
                        o.bx.set_border_color(color.new(C_BRK, 30))
                        o.bx.set_border_style(line.style_dashed)
                        o.bx.set_text_color(C_BRK)
                        o.bx.set_text(o.dir == 1 ? "Breaker ▼" : "Breaker ▲")
                    else
                        kill := true
            else
                kill := o.dir == 1 ? close > o.top : close < o.bot
            if kill
                o.bx.delete()
                obs.remove(i)
            else
                o.bx.set_right(bar_index + 10)

// ════════════════════════════════════════════════════════════
// 9. RMI Trend
// ════════════════════════════════════════════════════════════
var int rState = 0
bool rPos = m_rmi and barOk and rmi > r_pos and ema5Chg > 0 and rState != 1
bool rNeg = m_rmi and barOk and rmi < r_neg and ema5Chg < 0 and rState != -1
if rPos
    rState := 1
if rNeg
    rState := -1

plot(m_rmi and r_ma and rState != 0 ? rmiMa : na, "RMI MA", color = rState == 1 ? r_colUp : r_colDn, linewidth = 3)
plotshape(rPos, "RMI Positive", shape.triangleup, location.belowbar, r_colUp, size = size.tiny)
plotshape(rNeg, "RMI Negative", shape.triangledown, location.abovebar, r_colDn, size = size.tiny)

// ════════════════════════════════════════════════════════════
// 10. الحجم على الشارت
// ════════════════════════════════════════════════════════════
bool vSpike = m_vol and hasVol and not na(rvol) and rvol >= v_mult
plotshape(vSpike and close >= open, "Volume Spike Up", shape.diamond, location.belowbar, color.new(C_UP, 20), size = size.tiny)
plotshape(vSpike and close < open, "Volume Spike Down", shape.diamond, location.abovebar, color.new(C_DN, 20), size = size.tiny)
plot(m_vol and v_vwap and hasVol ? vwapV : na, "VWAP", color = color.new(#FFB300, 20), linewidth = 2)

// ════════════════════════════════════════════════════════════
// 11. Volume Screener (جدول عدة رموز)
// ════════════════════════════════════════════════════════════
f_scrData() =>
    [stv, std] = ta.supertrend(s_sens, s_atrLen)
    float v = nz(volume)
    float a = ta.sma(v, v_len)
    [close, ta.change(close) / close[1] * 100, a > 0 ? v / a : na, std < 0 ? 1 : -1, ta.rsi(close, v_len)]

// عند تعطيل الوحدة أو الرمز يُطلب الرمز الحالي فقط (لتسريع التحميل)
f_sym(bool on, string s) =>
    m_vol and on ? s : syminfo.tickerid

[pc1, ch1, rv1, dr1, rs1]   = request.security(f_sym(on1, sym1), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc2, ch2, rv2, dr2, rs2]   = request.security(f_sym(on2, sym2), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc3, ch3, rv3, dr3, rs3]   = request.security(f_sym(on3, sym3), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc4, ch4, rv4, dr4, rs4]   = request.security(f_sym(on4, sym4), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc5, ch5, rv5, dr5, rs5]   = request.security(f_sym(on5, sym5), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc6, ch6, rv6, dr6, rs6]   = request.security(f_sym(on6, sym6), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc7, ch7, rv7, dr7, rs7]   = request.security(f_sym(on7, sym7), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc8, ch8, rv8, dr8, rs8]   = request.security(f_sym(on8, sym8), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc9, ch9, rv9, dr9, rs9]   = request.security(f_sym(on9, sym9), timeframe.period, f_scrData(), ignore_invalid_symbol = true)
[pc10, ch10, rv10, dr10, rs10] = request.security(f_sym(on10, sym10), timeframe.period, f_scrData(), ignore_invalid_symbol = true)

f_tblPos(string p) =>
    p == "Top Left" ? position.top_left : p == "Bottom Left" ? position.bottom_left : p == "Middle Right" ? position.middle_right : position.top_right

string scrSize = v_size == "كبير" ? size.normal : v_size == "متوسط" ? size.small : size.tiny
var table scr = table.new(f_tblPos(v_pos), 6, 11, bgcolor = color.new(#0A0E17, 15), border_width = 1, border_color = color.new(color.gray, 85))

f_scrRow(int row, bool on, string s, float pc, float ch, float rv, int dr, float rs) =>
    if on
        array<string> parts = str.split(s, ":")
        string name = parts.size() > 0 ? parts.last() : s
        color  chCol = na(ch) ? color.gray : ch >= 0 ? C_UP : C_DN
        scr.cell(0, row, name, text_color = C_TXT, text_size = scrSize, text_halign = text.align_left)
        scr.cell(1, row, na(pc) ? "—" : str.tostring(pc, "#.#####"), text_color = C_TXT, text_size = scrSize)
        scr.cell(2, row, na(ch) ? "—" : (ch >= 0 ? "+" : "") + str.tostring(ch, "#.##") + "%", text_color = chCol, text_size = scrSize)
        scr.cell(3, row, na(rv) ? "n/a" : str.tostring(rv, "#.##") + "×", text_color = not na(rv) and rv >= v_mult ? C_SL : C_TXT, text_size = scrSize)
        scr.cell(4, row, na(rs) ? "—" : str.tostring(rs, "#"), text_color = rs >= 70 ? C_DN : rs <= 30 ? C_UP : C_TXT, text_size = scrSize)
        scr.cell(5, row, na(dr) ? "—" : dr == 1 ? "▲" : "▼", text_color = dr == 1 ? C_UP : C_DN, text_size = scrSize)
    else
        for c = 0 to 5
            scr.cell(c, row, "")
    true

if m_vol and barstate.islast
    array<string> hdr = array.from("Symbol", "Price", "Chg", "RVOL", "RSI", "Trend")
    for c = 0 to 5
        scr.cell(c, 0, hdr.get(c), text_color = color.gray, text_size = scrSize, bgcolor = color.black)
    f_scrRow(1, on1, sym1, pc1, ch1, rv1, dr1, rs1)
    f_scrRow(2, on2, sym2, pc2, ch2, rv2, dr2, rs2)
    f_scrRow(3, on3, sym3, pc3, ch3, rv3, dr3, rs3)
    f_scrRow(4, on4, sym4, pc4, ch4, rv4, dr4, rs4)
    f_scrRow(5, on5, sym5, pc5, ch5, rv5, dr5, rs5)
    f_scrRow(6, on6, sym6, pc6, ch6, rv6, dr6, rs6)
    f_scrRow(7, on7, sym7, pc7, ch7, rv7, dr7, rs7)
    f_scrRow(8, on8, sym8, pc8, ch8, rv8, dr8, rs8)
    f_scrRow(9, on9, sym9, pc9, ch9, rv9, dr9, rs9)
    f_scrRow(10, on10, sym10, pc10, ch10, rv10, dr10, rs10)

// ════════════════════════════════════════════════════════════
// 12. إدارة رأس المال (Capital / % Risk / % SL / RR)
// ════════════════════════════════════════════════════════════
// الاتجاه الحالي يحدد الشراء أو البيع، والوقف نسبة مئوية من سعر الدخول
float rate    = na(fxRate) ? 1.0 : fxRate
float riskAmt = c_cap * c_risk / 100
int   rkDir   = trend
float rkSL    = close * (1 - rkDir * c_sl / 100)
float rkTP    = close * (1 + rkDir * c_sl * c_rr / 100)
float perUnit = close * c_sl / 100 * syminfo.pointvalue * rate
float units   = perUnit > 0 ? riskAmt / perUnit : na
float posVal  = na(units) ? na : units * close * syminfo.pointvalue * rate

f_sizeText(float u) =>
    string res = "—"
    if not na(u)
        if syminfo.type == "forex"
            res := str.tostring(u / 100000, "#.##") + " lot"
        else if syminfo.type == "stock" or syminfo.type == "fund"
            res := str.tostring(math.floor(u)) + " shares"
        else if syminfo.type == "futures"
            res := str.tostring(u, "#.##") + " contracts"
        else
            res := str.tostring(u, "#.####") + " units"
    res

// ════════════════════════════════════════════════════════════
// 13. لوحة المعلومات
// ════════════════════════════════════════════════════════════
var table dash = table.new(position.bottom_right, 2, 12, bgcolor = color.new(#0A0E17, 15), border_width = 1, border_color = color.new(color.gray, 85))

f_row(int row, string k, string v, color c) =>
    dash.cell(0, row, k, text_color = C_TXT, text_size = size.small, text_halign = text.align_left)
    dash.cell(1, row, v, text_color = c, text_size = size.small)

if m_dash and barstate.islast
    dash.cell(0, 0, "HFJ PRO", text_color = C_TXT, text_size = size.small, bgcolor = color.black)
    dash.cell(1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.gray, text_size = size.small, bgcolor = color.black)
    f_row(1, "Trend", trend == 1 ? "Bullish ▲" : "Bearish ▼", trend == 1 ? C_UP : C_DN)
    string posTxt = tDir == 1 ? "Long" : tDir == -1 ? "Short" : "—"
    f_row(2, "Signal", m_sig ? posTxt + " @ " + str.tostring(tEntry, format.mintick) : "off", tDir == 1 ? C_UP : tDir == -1 ? C_DN : color.gray)
    f_row(3, "Trailing TP", m_sig and s_trail ? (trailLive ? str.tostring(trail, format.mintick) : "Closed ✓") : "—", C_TP)
    f_row(4, "RMI", m_rmi ? str.tostring(rmi, "#.0") + (rState == 1 ? " Positive" : rState == -1 ? " Negative" : "") : "off", rState == 1 ? r_colUp : rState == -1 ? r_colDn : color.gray)
    string vTxt = not m_vol ? "off" : not hasVol ? "no volume data" : "RVOL " + str.tostring(rvol, "#.##") + "×"
    f_row(5, "Volume", vTxt, vSpike ? C_SL : C_TXT)
    string oTxt = not m_orb ? "off" : not timeframe.isintraday ? "intraday only" : inOrb ? "forming..." : not orbReady ? "—" : close > orbHi ? "above ▲" : close < orbLo ? "below ▼" : "inside"
    f_row(6, "ORB", oTxt, orbReady and close > orbHi ? C_UP : orbReady and close < orbLo ? C_DN : color.gray)
    f_row(7, "Risk " + str.tostring(c_risk) + "%", m_risk ? str.tostring(riskAmt, "#,###.##") + " " + c_cur : "off", C_TXT)
    f_row(8, "Position size", m_risk ? f_sizeText(units) : "off", C_SL)
    f_row(9, "Position value", m_risk and not na(posVal) ? str.tostring(posVal, "#,###.##") + " " + c_cur : "—", C_TXT)
    f_row(10, "SL " + str.tostring(c_sl) + "%", m_risk ? str.tostring(rkSL, format.mintick) : "—", C_DN)
    f_row(11, "TP " + str.tostring(c_rr) + "R", m_risk ? str.tostring(rkTP, format.mintick) : "—", C_TP)

// ════════════════════════════════════════════════════════════
// 14. التنبيهات
// ════════════════════════════════════════════════════════════
// تنبيه شامل: أنشئ تنبيهاً واختر "Any alert() function call"
string tk = syminfo.ticker + " @ " + str.tostring(close, format.mintick)
if buySig
    alert("HFJ Pro: " + (strongBuy ? "▲+ Buy " : "▲ Buy ") + tk, alert.freq_once_per_bar_close)
if sellSig
    alert("HFJ Pro: " + (strongSell ? "▼+ Sell " : "▼ Sell ") + tk, alert.freq_once_per_bar_close)
if tpLong or tpShort
    alert("HFJ Pro: TP ✓ " + tk, alert.freq_once_per_bar_close)
if tpHitNow
    alert("HFJ Pro: TP" + str.tostring(tpHit) + " ✓ " + tk, alert.freq_once_per_bar)
if trailExit
    alert("HFJ Pro: Trailing TP ✓ " + tk, alert.freq_once_per_bar_close)
if liqSweepUp
    alert("HFJ Pro: اصطياد سيولة القمة (BSL) " + tk, alert.freq_once_per_bar_close)
if liqSweepDn
    alert("HFJ Pro: اصطياد سيولة القاع (SSL) " + tk, alert.freq_once_per_bar_close)
if orbUp or orbDn
    alert("HFJ Pro: ORB " + (orbUp ? "اختراق ▲ " : "كسر ▼ ") + tk, alert.freq_once_per_bar_close)
if tlBreakUp or tlBreakDn
    alert("HFJ Pro: كسر خط اتجاه " + (tlBreakUp ? "▲ " : "▼ ") + tk, alert.freq_once_per_bar_close)
if rPos or rNeg
    alert("HFJ Pro: RMI " + (rPos ? "Positive ▲ " : "Negative ▼ ") + tk, alert.freq_once_per_bar_close)

alertcondition(buySig, "Buy", "HFJ Pro: Buy على {{ticker}} عند {{close}}")
alertcondition(sellSig, "Sell", "HFJ Pro: Sell على {{ticker}} عند {{close}}")
alertcondition(strongBuy, "Strong Buy", "HFJ Pro: Buy+ على {{ticker}} عند {{close}}")
alertcondition(strongSell, "Strong Sell", "HFJ Pro: Sell+ على {{ticker}} عند {{close}}")
alertcondition(tpLong or tpShort, "TP", "HFJ Pro: TP ✓ على {{ticker}} عند {{close}}")
alertcondition(trailExit, "Trailing TP", "HFJ Pro: Trailing TP على {{ticker}}")
alertcondition(liqSweepUp or liqSweepDn, "Liquidity Sweep", "HFJ Pro: اصطياد سيولة على {{ticker}}")
alertcondition(orbUp or orbDn, "ORB Breakout", "HFJ Pro: اختراق ORB على {{ticker}}")
alertcondition(tlBreakUp or tlBreakDn, "TrendLine Break", "HFJ Pro: كسر خط اتجاه على {{ticker}}")
alertcondition(rPos or rNeg, "RMI Trend Change", "HFJ Pro: تغير RMI على {{ticker}}")
alertcondition(vSpike, "Volume Spike", "HFJ Pro: حجم مرتفع على {{ticker}}")
