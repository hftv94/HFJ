// النسخة v10.0 - kNN + SuperTrend + كتل الأوامر (OB/Breaker) + نطاق الافتتاح (ORB) + مناطق السيولة مع Volume Delta
//@version=6
indicator("HFJ Quantum v10.0", shorttitle = "HFJ Q", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 500)

// ════════════════════════════════════════════════════════════
// 0. الثوابت والأنواع
// ════════════════════════════════════════════════════════════
const string GRP_SIG    = "عرض الإشارات"
const string GRP_ML     = "محرك التعلم الآلي (kNN)"
const string GRP_MAJOR  = "الإشارات الكبرى (SuperTrend + AI)"
const string GRP_OB     = "كتل الأوامر (Order Blocks)"
const string GRP_ORB    = "نطاق الافتتاح (ORB)"
const string GRP_LIQ    = "مناطق السيولة (Liquidity Zones)"
const string GRP_AI     = "فلتر الاتجاه السريع"
const string GRP_FILTER = "الفلاتر"
const string GRP_MA     = "المتوسطات المتحركة"
const string GRP_RISK   = "إدارة المخاطر"
const string GRP_VISUAL = "التنسيق البصري"

const string MODE_ALL   = "كل الإشارات"
const string MODE_MAJOR = "الإشارات الكبرى فقط"

const color C_BULL    = #00FF88 // زمردي ليزري
const color C_BEAR    = #FF4400 // ياقوتي لاهب
const color C_SL      = #FFD700 // ذهبي ملكي للوقف
const color C_NEUT    = #555555 // رمادي معدني
const color C_ENTRY   = #FFFFFF
const color C_MA50    = #29B6F6 // أزرق سماوي
const color C_MA200   = #E040FB // بنفسجي
const color C_OB_BULL = #00BFA5 // كتلة شرائية
const color C_OB_BEAR = #FF5252 // كتلة بيعية
const color C_BREAKER = #FF9800 // Breaker
const color C_ORB     = #42A5F5 // نطاق الافتتاح
const color C_LIQ_RES = #F23645 // سيولة القمم
const color C_LIQ_SUP = #089981 // سيولة القيعان
const color C_SWEPT   = #787B86 // منطقة تم اختراقها

type OrderBlock
    box    bx
    float  top
    float  bottom
    int    dir            // 1 = شرائية، -1 = بيعية
    string strength
    bool   isBreaker = false

type LiqZone
    box   bx
    float top
    float bottom
    int   dir             // 1 = سيولة قمة (مقاومة)، -1 = سيولة قاع (دعم)
    float buyVol  = 0.0
    float sellVol = 0.0
    bool  active  = true

// ════════════════════════════════════════════════════════════
// 1. المدخلات
// ════════════════════════════════════════════════════════════
bool  i_showMajorSig = input.bool(true, "إظهار الإشارات الكبرى (MAJOR)", group = GRP_SIG)
bool  i_showRegular  = input.bool(false, "إظهار الإشارات العادية (▲▼)", group = GRP_SIG, tooltip = "الإشارات السريعة المبنية على RSI/EMA. مخفية افتراضياً للاعتماد على الإشارات القوية فقط")
bool  i_showHistory  = input.bool(true, "إظهار الإشارات التاريخية", group = GRP_SIG, tooltip = "عند الإيقاف يبقى آخر إشارة فقط من كل نوع على الشارت")

int   i_mlLookback = input.int(1000, "عدد الشموع التاريخية للمقارنة", minval = 100, maxval = 5000, group = GRP_ML, tooltip = "المحرك يقارن الوضع الحالي بهذا العدد من الشموع السابقة")
int   i_k          = input.int(10, "عدد الجيران الأقرب (K)", minval = 3, maxval = 50, group = GRP_ML)
int   i_horizon    = input.int(4, "أفق التوقع (شموع)", minval = 1, maxval = 50, group = GRP_ML, tooltip = "هل ارتفع السعر أم انخفض بعد هذا العدد من الشموع؟ هذا ما يتعلمه المحرك من كل جار")
int   i_stride     = input.int(2, "تباعد العينات", minval = 1, maxval = 10, group = GRP_ML, tooltip = "1 = مقارنة كل شمعة. رفع القيمة يسرّع الحساب ويقلل تكرار الجيران المتلاصقة")
int   i_mlBars     = input.int(3000, "تشغيل المحرك على آخر N شمعة", minval = 100, maxval = 20000, group = GRP_ML, tooltip = "لتسريع تحميل المؤشر. قبل ذلك لا يُحسب التوقع")

float i_stFactor   = input.float(3.0, "معامل SuperTrend", minval = 0.5, step = 0.1, group = GRP_MAJOR)
int   i_stAtr      = input.int(10, "فترة ATR لـ SuperTrend", minval = 1, group = GRP_MAJOR)
float i_conf       = input.float(90.0, "حد ثقة الذكاء الاصطناعي %", minval = 50.0, maxval = 100.0, step = 5.0, group = GRP_MAJOR, tooltip = "لا تظهر الإشارة الكبرى إلا إذا تجاوزت نسبة توقع AI هذا الحد واتفقت مع SuperTrend")
bool  i_showSt     = input.bool(true, "إظهار خط SuperTrend", group = GRP_MAJOR)
bool  i_majorBg    = input.bool(true, "تلوين خلفية شمعة الإشارة الكبرى", group = GRP_MAJOR)

bool  i_showOb     = input.bool(true, "تفعيل كتل الأوامر", group = GRP_OB)
int   i_obLen      = input.int(5, "طول المحور (شموع)", minval = 2, maxval = 50, group = GRP_OB, tooltip = "الشمعة المحورية يجب أن يكون حجمها الأعلى بين هذا العدد من الشموع قبلها وبعدها")
float i_obVolMult  = input.float(1.5, "الحد الأدنى للحجم (× المتوسط)", minval = 0.5, step = 0.1, group = GRP_OB)
float i_obMed      = input.float(2.0, "حد القوة Medium (× المتوسط)", minval = 1.0, step = 0.1, group = GRP_OB)
float i_obHigh     = input.float(3.0, "حد القوة High (× المتوسط)", minval = 1.0, step = 0.1, group = GRP_OB)
bool  i_obBreaker  = input.bool(true, "تفعيل Breaker Blocks", group = GRP_OB, tooltip = "عند كسر الكتلة تتحول إلى Breaker بدلاً من حذفها: الدعم المكسور يصبح مقاومة والعكس")
int   i_obMax      = input.int(8, "أقصى عدد للكتل", minval = 1, maxval = 50, group = GRP_OB)

bool  i_showOrb    = input.bool(true, "تفعيل نطاق الافتتاح", group = GRP_ORB, tooltip = "يعمل على الفريمات اللحظية فقط (أقل من يومي)")
string i_orbSess   = input.session("0930-1000", "فترة نطاق الافتتاح", group = GRP_ORB, tooltip = "بتوقيت البورصة. للأسهم الأمريكية 0930-1000 = أول 30 دقيقة")
int   i_orbDays    = input.int(3, "عدد الأيام المعروضة", minval = 1, maxval = 30, group = GRP_ORB)

bool  i_showLiq    = input.bool(true, "تفعيل مناطق السيولة", group = GRP_LIQ)
int   i_liqLen     = input.int(10, "طول المحور (شموع)", minval = 2, maxval = 50, group = GRP_LIQ)
int   i_liqMax     = input.int(8, "أقصى عدد للمناطق", minval = 1, maxval = 50, group = GRP_LIQ)
bool  i_liqDelta   = input.bool(true, "عرض تحليل الحجم (Bull% / Bear% / Delta)", group = GRP_LIQ)

int   i_knnLen     = input.int(30, "نافذة البحث", minval = 2, maxval = 200, group = GRP_AI, tooltip = "عدد الشموع السابقة التي يقارن بها الفلتر السعر الحالي")

int   i_rsiLen     = input.int(14, "فترة RSI", minval = 2, group = GRP_FILTER)
int   i_emaLen     = input.int(9, "فترة EMA السريع", minval = 1, group = GRP_FILTER)
bool  i_confirm    = input.bool(true, "تأكيد الإشارة عند إغلاق الشمعة", group = GRP_FILTER, tooltip = "يمنع ظهور واختفاء الإشارة أثناء تكوّن الشمعة (بدون إعادة رسم)")

bool  i_showMa50   = input.bool(true, "إظهار المتوسط 50", inline = "ma50", group = GRP_MA)
int   i_ma50Len    = input.int(50, "", minval = 1, inline = "ma50", group = GRP_MA)
bool  i_showMa200  = input.bool(true, "إظهار المتوسط 200", inline = "ma200", group = GRP_MA)
int   i_ma200Len   = input.int(200, "", minval = 1, inline = "ma200", group = GRP_MA)
string i_maType    = input.string("EMA", "نوع المتوسط", options = ["EMA", "SMA"], group = GRP_MA)

string i_tradeMode = input.string(MODE_MAJOR, "فتح الصفقات على", options = [MODE_ALL, MODE_MAJOR], group = GRP_RISK)
float i_rr         = input.float(2.0, "نسبة الهدف (R:R)", minval = 0.1, step = 0.1, group = GRP_RISK)
int   i_slLookback = input.int(5, "نطاق وقف الخسارة (شموع)", minval = 2, group = GRP_RISK)
float i_slBuffer   = input.float(0.1, "هامش الوقف (× ATR)", minval = 0.0, step = 0.05, group = GRP_RISK)

int   i_ext        = input.int(10, "امتداد الخطوط أمام السعر", minval = 1, maxval = 100, group = GRP_VISUAL)
int   i_history    = input.int(3, "عدد الصفقات السابقة على الشارت", minval = 0, maxval = 50, group = GRP_VISUAL)
int   i_zoneExt    = input.int(15, "امتداد المناطق أمام السعر", minval = 1, maxval = 200, group = GRP_VISUAL)
bool  i_showHud    = input.bool(true, "إظهار لوحة التحكم (HUD)", group = GRP_VISUAL)

// ════════════════════════════════════════════════════════════
// 2. الحسابات (كل دوال ta.* تُستدعى على كل شمعة وفي النطاق العام)
// ════════════════════════════════════════════════════════════
float atr10   = ta.atr(10)
float atr14   = ta.atr(14)
float rsiVal  = ta.rsi(close, i_rsiLen)
float emaFast = ta.ema(close, i_emaLen)
float lowest  = ta.lowest(low, i_slLookback)
float highest = ta.highest(high, i_slLookback)

float range_  = high - low
float rawClv  = range_ > 0 ? ((close - low) - (high - close)) / range_ : 0.0
float clv     = ta.sma(rawClv, 3)

float ma50  = i_maType == "EMA" ? ta.ema(close, i_ma50Len) : ta.sma(close, i_ma50Len)
float ma200 = i_maType == "EMA" ? ta.ema(close, i_ma200Len) : ta.sma(close, i_ma200Len)

[stLine, stDir] = ta.supertrend(i_stFactor, i_stAtr)
bool stUp = stDir < 0 // في TradingView: الاتجاه السالب = صاعد

// الحجم والسيولة
float vol       = nz(volume)
float volSma    = ta.sma(vol, 50)
float dailyAdv  = request.security(syminfo.tickerid, "D", ta.sma(volume, 20)[1], lookahead = barmerge.lookahead_on) // متوسط السيولة اليومية (20 يوم)
float buyPart   = range_ > 0 ? vol * (close - low) / range_ : vol * 0.5 // تقدير حجم المشترين داخل الشمعة
float sellPart  = vol - buyPart

// المحاور
float volPivot = ta.pivothigh(vol, i_obLen, i_obLen)
float liqPh    = ta.pivothigh(high, i_liqLen, i_liqLen)
float liqPl    = ta.pivotlow(low, i_liqLen, i_liqLen)

bool confirmed = barstate.isconfirmed

// فلتر الاتجاه السريع: يصوّت بالشموع السابقة القريبة من السعر الحالي (أقل من ATR)
int bullVotes = 0
int bearVotes = 0
for i = 1 to i_knnLen
    if math.abs(close - close[i]) < atr10
        bullVotes += close[i] > open[i] ? 1 : 0
        bearVotes += close[i] < open[i] ? 1 : 0
int trendAi = bullVotes > bearVotes ? 1 : bearVotes > bullVotes ? -1 : 0

// ════════════════════════════════════════════════════════════
// 3. محرك التعلم الآلي kNN
// ════════════════════════════════════════════════════════════
// تحويل أي قيمة إلى نطاق 0..1 بشكل ناعم (لتوحيد مقياس الخصائص)
f_squash(float x) =>
    0.5 + 0.5 * x / (1.0 + math.abs(x))

// خصائص "بصمة السوق" لكل شمعة — كلها بين 0 و 1
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)
float atrSafe = nz(atr14) > 0 ? atr14 : syminfo.mintick
float feat1 = ta.rsi(close, 14) / 100.0                         // الزخم
float feat2 = ta.stoch(close, high, low, 14) / 100.0           // موقع السعر في النطاق
float feat3 = adxVal / 100.0                                    // قوة الاتجاه
float feat4 = f_squash((close - ma50) / atrSafe)                // البعد عن المتوسط 50
float feat5 = f_squash((close - nz(close[5], close)) / atrSafe) // سرعة الحركة

// ذاكرة المحرك: آخر (lookback + horizon) شمعة
var array<float> mF1 = array.new<float>()
var array<float> mF2 = array.new<float>()
var array<float> mF3 = array.new<float>()
var array<float> mF4 = array.new<float>()
var array<float> mF5 = array.new<float>()
var array<float> mClose = array.new<float>()

mF1.push(feat1)
mF2.push(feat2)
mF3.push(feat3)
mF4.push(feat4)
mF5.push(feat5)
mClose.push(close)
while mClose.size() > i_mlLookback + i_horizon + 1
    mF1.shift()
    mF2.shift()
    mF3.shift()
    mF4.shift()
    mF5.shift()
    mClose.shift()

float probUp   = na
float probDown = na
int   nnFound  = 0
int   memSize  = mClose.size()

if bar_index >= last_bar_index - i_mlBars and memSize > i_horizon + i_k
    int curIdx = memSize - 1
    float c1 = mF1.get(curIdx)
    float c2 = mF2.get(curIdx)
    float c3 = mF3.get(curIdx)
    float c4 = mF4.get(curIdx)
    float c5 = mF5.get(curIdx)

    array<float> nnDist  = array.new<float>(i_k, 1e10)
    array<int>   nnLabel = array.new<int>(i_k, 0)
    float worst = 1e10

    // الشموع المؤهلة: التي مرّ عليها أفق التوقع ونعرف نتيجتها (بدون نظر للمستقبل)
    int pStart = math.max(0, curIdx - i_mlLookback)
    int pStop  = curIdx - i_horizon
    if pStop >= pStart
        for p = pStart to pStop by i_stride
            float d = math.pow(c1 - mF1.get(p), 2) + math.pow(c2 - mF2.get(p), 2) + math.pow(c3 - mF3.get(p), 2) + math.pow(c4 - mF4.get(p), 2) + math.pow(c5 - mF5.get(p), 2)
            if not na(d) and d < worst
                int slot = nnDist.indexof(worst)
                float fut = mClose.get(p + i_horizon)
                float nowPx = mClose.get(p)
                nnDist.set(slot, d)
                nnLabel.set(slot, fut > nowPx ? 1 : fut < nowPx ? -1 : 0)
                worst := nnDist.max()

    int ups   = 0
    int downs = 0
    for j = 0 to i_k - 1
        if nnDist.get(j) < 1e10
            nnFound += 1
            ups     += nnLabel.get(j) == 1 ? 1 : 0
            downs   += nnLabel.get(j) == -1 ? 1 : 0
    if nnFound > 0
        probUp   := ups * 100.0 / nnFound
        probDown := downs * 100.0 / nnFound

// ════════════════════════════════════════════════════════════
// 4. الإشارات
// ════════════════════════════════════════════════════════════
bool barOk = not i_confirm or barstate.isconfirmed

// أ) الإشارات الكبرى: SuperTrend + توقع AI فوق حد الثقة
bool majorLongCond  = stUp and not na(probUp) and probUp >= i_conf
bool majorShortCond = not stUp and not na(probDown) and probDown >= i_conf

var int majorState = 0
bool majorLong  = barOk and majorLongCond and majorState != 1
bool majorShort = barOk and majorShortCond and majorState != -1
if majorLong
    majorState := 1
if majorShort
    majorState := -1

// ب) الإشارات العادية (مستقلة عن الصفقات، للعرض فقط)
bool condLong  = trendAi == 1 and close > emaFast and rsiVal > 50 and clv > 0
bool condShort = trendAi == -1 and close < emaFast and rsiVal < 50 and clv < 0

var int regState = 0
bool regLong  = barOk and condLong and regState != 1
bool regShort = barOk and condShort and regState != -1
if regLong
    regState := 1
if regShort
    regState := -1

// ج) إشارات فتح الصفقات حسب الوضع المختار
bool majorOnly  = i_tradeMode == MODE_MAJOR
bool entryLong  = majorOnly ? majorLong : condLong
bool entryShort = majorOnly ? majorShort : condShort

var int tradeState = 0
bool trigLong  = barOk and entryLong and tradeState != 1
bool trigShort = barOk and entryShort and tradeState != -1

if trigLong
    tradeState := 1
if trigShort
    tradeState := -1

// ════════════════════════════════════════════════════════════
// 5. الرسم الأساسي
// ════════════════════════════════════════════════════════════
color baseCol = tradeState == 1 ? C_BULL : tradeState == -1 ? C_BEAR : C_NEUT
plotcandle(open, high, low, close, "Quantum Candles", color = baseCol, wickcolor = baseCol, bordercolor = baseCol)

var float trackLine = close
trackLine += 0.15 * (close - trackLine)
float finalLine = ta.wma(trackLine, 5)

pTrend = plot(finalLine, "مسار الاتجاه", color = baseCol, linewidth = 3)
pEma   = plot(emaFast, "EMA", display = display.none)
fill(pTrend, pEma, color = tradeState == 0 ? na : color.new(baseCol, 90), title = "تعبئة الاتجاه")

plot(i_showMa50 ? ma50 : na, "المتوسط 50", color = C_MA50, linewidth = 2)
plot(i_showMa200 ? ma200 : na, "المتوسط 200", color = C_MA200, linewidth = 2)

bool stFlip = stDir != stDir[1]
plot(i_showSt and not stFlip ? stLine : na, "SuperTrend", color = stUp ? color.new(C_BULL, 30) : color.new(C_BEAR, 30), linewidth = 2, style = plot.style_linebr)

bool showBg = i_majorBg and i_showMajorSig and i_showHistory
bgcolor(showBg and majorLong ? color.new(C_BULL, 80) : showBg and majorShort ? color.new(C_BEAR, 80) : na, title = "خلفية الإشارة الكبرى")

// ════════════════════════════════════════════════════════════
// 6. كتل الأوامر (Order Blocks + Breaker Blocks)
// ════════════════════════════════════════════════════════════
// الكتلة = شمعة محورية بأعلى حجم بين جيرانها، تليها حركة اندفاعية تكسر طرفها
var array<OrderBlock> obs = array.new<OrderBlock>()
bool obSupportBroken = false // كتلة شرائية كُسرت (تحولت لمقاومة)
bool obResistBroken  = false // كتلة بيعية اختُرقت (تحولت لدعم)
int  obBullCnt = 0
int  obBearCnt = 0

if i_showOb and confirmed
    // أ) اكتشاف كتلة جديدة
    float pivVol = vol[i_obLen]
    float avgVol = volSma[i_obLen]
    bool  volOk  = not na(volPivot) and avgVol > 0 and pivVol >= avgVol * i_obVolMult
    int   newDir = volOk and close > high[i_obLen] ? 1 : volOk and close < low[i_obLen] ? -1 : 0
    if newDir != 0
        float relVol   = pivVol / avgVol
        string strength = relVol >= i_obHigh ? "High" : relVol >= i_obMed ? "Medium" : "Low"
        int   transp   = strength == "High" ? 60 : strength == "Medium" ? 75 : 88
        float obTop    = newDir == 1 ? math.max(open[i_obLen], close[i_obLen]) : high[i_obLen]
        float obBot    = newDir == 1 ? low[i_obLen] : math.min(open[i_obLen], close[i_obLen])
        obTop := math.max(obTop, obBot + syminfo.mintick)
        string advTxt  = nz(dailyAdv) > 0 ? " · " + str.tostring(pivVol / dailyAdv * 100, "#.#") + "% ADV" : ""
        string obTxt   = (newDir == 1 ? "Bull OB · " : "Bear OB · ") + strength + advTxt
        color  obCol   = newDir == 1 ? C_OB_BULL : C_OB_BEAR
        box obBox = box.new(bar_index - i_obLen, obTop, bar_index + i_zoneExt, obBot, border_color = color.new(obCol, 40), bgcolor = color.new(obCol, transp), text = obTxt, text_color = obCol, text_size = size.tiny, text_halign = text.align_right)
        obs.push(OrderBlock.new(obBox, obTop, obBot, newDir, strength))
        while obs.size() > i_obMax
            OrderBlock oldOb = obs.shift()
            oldOb.bx.delete()

    // ب) تحديث الكتل: كسر ← Breaker، واسترداد Breaker ← حذف
    if obs.size() > 0
        for idx = obs.size() - 1 to 0
            OrderBlock ob = obs.get(idx)
            bool kill = false
            if not ob.isBreaker
                bool broken = ob.dir == 1 ? close < ob.bottom : close > ob.top
                if broken
                    obSupportBroken := obSupportBroken or ob.dir == 1
                    obResistBroken  := obResistBroken or ob.dir == -1
                    if i_obBreaker
                        ob.isBreaker := true
                        ob.bx.set_bgcolor(color.new(C_BREAKER, 85))
                        ob.bx.set_border_color(color.new(C_BREAKER, 30))
                        ob.bx.set_border_style(line.style_dashed)
                        ob.bx.set_text_color(C_BREAKER)
                        ob.bx.set_text((ob.dir == 1 ? "Breaker ▼ (مقاومة) · " : "Breaker ▲ (دعم) · ") + ob.strength)
                    else
                        kill := true
            else
                kill := ob.dir == 1 ? close > ob.top : close < ob.bottom
            if kill
                ob.bx.delete()
                obs.remove(idx)
            else
                ob.bx.set_right(bar_index + i_zoneExt)

if obs.size() > 0
    for ob in obs
        if not ob.isBreaker
            obBullCnt += ob.dir == 1 ? 1 : 0
            obBearCnt += ob.dir == -1 ? 1 : 0

// ════════════════════════════════════════════════════════════
// 7. نطاق الافتتاح (ORB - Opening Range Breakout)
// ════════════════════════════════════════════════════════════
bool orbTfOk  = timeframe.isintraday
bool inOrb    = i_showOrb and orbTfOk and not na(time(timeframe.period, i_orbSess))
bool orbStart = inOrb and not inOrb[1]
bool orbEnd   = not inOrb and inOrb[1]
bool newDay   = timeframe.change("D")

var float orbHi        = na
var float orbLo        = na
var bool  orbReady     = false // اكتمل النطاق ويمكن الاختراق
var bool  orbLive      = false // خطوط اليوم ما زالت تمتد
var bool  orbLongDone  = false
var bool  orbShortDone = false
var line  orbHiLn  = na
var line  orbLoLn  = na
var line  orbMidLn = na
var box   orbBox   = na
var array<line> orbLineHist = array.new<line>()
var array<box>  orbBoxHist  = array.new<box>()

if newDay
    orbReady := false
    orbLive  := false

if orbStart
    orbHi        := high
    orbLo        := low
    orbReady     := false
    orbLive      := true
    orbLongDone  := false
    orbShortDone := false
    orbHiLn  := line.new(bar_index, high, bar_index, high, color = C_BULL, width = 2)
    orbLoLn  := line.new(bar_index, low, bar_index, low, color = C_BEAR, width = 2)
    orbMidLn := line.new(bar_index, hl2, bar_index, hl2, color = color.gray, width = 1, style = line.style_dotted)
    orbBox   := box.new(bar_index, high, bar_index, low, border_color = color.new(C_ORB, 60), bgcolor = color.new(C_ORB, 90), text = "ORB", text_color = C_ORB, text_size = size.tiny, text_valign = text.align_top)
    orbLineHist.push(orbHiLn)
    orbLineHist.push(orbLoLn)
    orbLineHist.push(orbMidLn)
    orbBoxHist.push(orbBox)
    while orbBoxHist.size() > i_orbDays
        box.delete(orbBoxHist.shift())
    while orbLineHist.size() > i_orbDays * 3
        line.delete(orbLineHist.shift())
else if inOrb
    orbHi := math.max(orbHi, high)
    orbLo := math.min(orbLo, low)

if orbEnd
    orbReady := true

if orbLive
    float orbMid = (orbHi + orbLo) / 2
    orbHiLn.set_y1(orbHi)
    orbHiLn.set_y2(orbHi)
    orbHiLn.set_x2(bar_index)
    orbLoLn.set_y1(orbLo)
    orbLoLn.set_y2(orbLo)
    orbLoLn.set_x2(bar_index)
    orbMidLn.set_y1(orbMid)
    orbMidLn.set_y2(orbMid)
    orbMidLn.set_x2(bar_index)
    orbBox.set_top(orbHi)
    orbBox.set_bottom(orbLo)
    if inOrb
        orbBox.set_right(bar_index)

bool orbLong  = orbReady and not orbLongDone and barOk and close > orbHi
bool orbShort = orbReady and not orbShortDone and barOk and close < orbLo
if orbLong
    orbLongDone := true
if orbShort
    orbShortDone := true

// ════════════════════════════════════════════════════════════
// 8. مناطق السيولة (Liquidity Zones + Volume Delta)
// ════════════════════════════════════════════════════════════
var array<LiqZone> liqs = array.new<LiqZone>()

f_liqText(LiqZone z) =>
    string base = z.dir == 1 ? "Liquidity ▲" : "Liquidity ▼"
    float  tot  = z.buyVol + z.sellVol
    string res  = base
    if i_liqDelta and tot > 0
        res := base + " | Bull " + str.tostring(z.buyVol / tot * 100, "#") + "% · Bear " + str.tostring(z.sellVol / tot * 100, "#") + "% | Δ " + str.tostring(z.buyVol - z.sellVol, format.volume)
    res

if i_showLiq and confirmed
    // أ) مناطق جديدة من القمم والقيعان المحورية (منطقة الذيل)
    float minH = nz(atr14[i_liqLen]) * 0.1
    if not na(liqPh)
        float zTop = high[i_liqLen]
        float zBot = math.min(math.max(open[i_liqLen], close[i_liqLen]), zTop - minH)
        box zBox = box.new(bar_index - i_liqLen, zTop, bar_index + i_zoneExt, zBot, border_color = color.new(C_LIQ_RES, 50), bgcolor = color.new(C_LIQ_RES, 85), text_color = C_LIQ_RES, text_size = size.tiny, text_halign = text.align_left)
        liqs.push(LiqZone.new(zBox, zTop, zBot, 1))
    if not na(liqPl)
        float zBot = low[i_liqLen]
        float zTop = math.max(math.min(open[i_liqLen], close[i_liqLen]), zBot + minH)
        box zBox = box.new(bar_index - i_liqLen, zTop, bar_index + i_zoneExt, zBot, border_color = color.new(C_LIQ_SUP, 50), bgcolor = color.new(C_LIQ_SUP, 85), text_color = C_LIQ_SUP, text_size = size.tiny, text_halign = text.align_left)
        liqs.push(LiqZone.new(zBox, zTop, zBot, -1))
    while liqs.size() > i_liqMax
        LiqZone oldZ = liqs.shift()
        oldZ.bx.delete()

    // ب) تحديث المناطق: تجميع الحجم داخل المنطقة، وتجميدها عند اختراقها
    if liqs.size() > 0
        for z in liqs
            if z.active
                if high >= z.bottom and low <= z.top
                    z.buyVol  := z.buyVol + buyPart
                    z.sellVol := z.sellVol + sellPart
                bool swept = z.dir == 1 ? close > z.top : close < z.bottom
                if swept
                    z.active := false
                    z.bx.set_right(bar_index)
                    z.bx.set_bgcolor(color.new(C_SWEPT, 90))
                    z.bx.set_border_color(color.new(C_SWEPT, 60))
                    z.bx.set_border_style(line.style_dotted)
                    z.bx.set_text_color(C_SWEPT)
                else
                    z.bx.set_right(bar_index + i_zoneExt)
                z.bx.set_text(f_liqText(z))

// ════════════════════════════════════════════════════════════
// 9. ملصقات الإشارات + إدارة التاريخ
// ════════════════════════════════════════════════════════════
var array<label> majorLbls = array.new<label>()
var array<label> regLbls   = array.new<label>()
var array<label> orbLbls   = array.new<label>()

f_keep(array<label> arr, int keep) =>
    while arr.size() > keep
        label.delete(arr.shift())
    arr.size()

if i_showMajorSig and majorLong
    majorLbls.push(label.new(bar_index, low - nz(atr14) * 1.5, "MAJOR LONG\n" + str.tostring(probUp, "#") + "%", color = C_BULL, textcolor = color.black, style = label.style_label_up, size = size.normal))
if i_showMajorSig and majorShort
    majorLbls.push(label.new(bar_index, high + nz(atr14) * 1.5, "MAJOR SHORT\n" + str.tostring(probDown, "#") + "%", color = C_BEAR, textcolor = color.white, style = label.style_label_down, size = size.normal))

if i_showRegular and regLong
    regLbls.push(label.new(bar_index, low - nz(atr14) * 0.5, "▲", color = C_BULL, textcolor = color.black, style = label.style_label_up, size = size.small))
if i_showRegular and regShort
    regLbls.push(label.new(bar_index, high + nz(atr14) * 0.5, "▼", color = C_BEAR, textcolor = color.white, style = label.style_label_down, size = size.small))

if orbLong
    orbLbls.push(label.new(bar_index, low - nz(atr14) * 0.8, "ORB ▲", color = C_ORB, textcolor = color.white, style = label.style_label_up, size = size.small))
if orbShort
    orbLbls.push(label.new(bar_index, high + nz(atr14) * 0.8, "ORB ▼", color = C_ORB, textcolor = color.white, style = label.style_label_down, size = size.small))

int keepSig = i_showHistory ? 500 : 1
f_keep(majorLbls, keepSig)
f_keep(regLbls, keepSig)
f_keep(orbLbls, keepSig)

// ════════════════════════════════════════════════════════════
// 10. إدارة الصفقة (تتبع حي حتى الهدف أو الوقف)
// ════════════════════════════════════════════════════════════
var bool  inTrade  = false
var int   tradeDir = 0
var float entryPx  = na
var float slPx     = na
var float tpPx     = na
var int   entryBar = na

var line  entryLn = na
var line  slLn    = na
var line  tpLn    = na
var label slLbl   = na
var label tpLbl   = na

var int wins   = 0
var int losses = 0

// أرشيف رسومات الصفقات المغلقة: 3 خطوط + 3 ملصقات لكل صفقة
var array<line>  oldLines  = array.new<line>()
var array<label> oldLabels = array.new<label>()

// أ) فحص الهدف/الوقف من الشمعة التالية للدخول
// إذا لُمس الاثنان في نفس الشمعة نحتسبها وقفاً (افتراض متحفظ)
bool hitSl = false
bool hitTp = false
if inTrade and bar_index > entryBar
    hitSl := tradeDir == 1 ? low <= slPx : high >= slPx
    hitTp := not hitSl and (tradeDir == 1 ? high >= tpPx : low <= tpPx)

// إشارة معاكسة أثناء صفقة مفتوحة = خروج بسعر الإغلاق
bool isReversal = inTrade and not hitSl and not hitTp and (trigLong or trigShort)
bool closeTrade = inTrade and (hitSl or hitTp or isReversal)

// ب) إغلاق الصفقة وتجميد رسوماتها
if closeTrade
    float exitPx = hitSl ? slPx : hitTp ? tpPx : close
    float pnl    = (exitPx - entryPx) * tradeDir
    bool  isWin  = pnl > 0
    wins   += isWin ? 1 : 0
    losses += isWin ? 0 : 1

    entryLn.set_x2(bar_index)
    slLn.set_x2(bar_index)
    tpLn.set_x2(bar_index)
    slLbl.set_x(bar_index)
    tpLbl.set_x(bar_index)

    string resTxt = hitTp ? "✔ TP" : hitSl ? "✖ SL" : "⇄ " + str.tostring(pnl, format.mintick)
    label resLbl = label.new(bar_index, exitPx, resTxt, style = label.style_label_left, color = isWin ? C_BULL : C_BEAR, textcolor = isWin ? color.black : color.white, size = size.small)

    oldLines.push(entryLn)
    oldLines.push(slLn)
    oldLines.push(tpLn)
    oldLabels.push(slLbl)
    oldLabels.push(tpLbl)
    oldLabels.push(resLbl)
    inTrade := false

// حذف أقدم الرسومات للإبقاء على آخر i_history صفقات فقط
while oldLines.size() > i_history * 3
    line.delete(oldLines.shift())
while oldLabels.size() > i_history * 3
    label.delete(oldLabels.shift())

// ج) فتح صفقة جديدة
if trigLong or trigShort
    int   tDir   = trigLong ? 1 : -1
    float buffer = nz(atr14) * i_slBuffer
    float slRaw  = tDir == 1 ? lowest - buffer : highest + buffer
    float risk   = math.max(math.abs(close - slRaw), syminfo.mintick)

    inTrade  := true
    tradeDir := tDir
    entryPx  := close
    slPx     := close - tDir * risk
    tpPx     := close + tDir * risk * i_rr
    entryBar := bar_index

    color tpCol   = tDir == 1 ? C_BULL : C_BEAR
    color tpTxt   = tDir == 1 ? color.black : color.white
    int   openX2  = bar_index + i_ext
    entryLn := line.new(bar_index, entryPx, openX2, entryPx, color = color.new(C_ENTRY, 40), width = 1, style = line.style_dotted)
    slLn    := line.new(bar_index, slPx, openX2, slPx, color = C_SL, width = 2, style = line.style_dashed)
    tpLn    := line.new(bar_index, tpPx, openX2, tpPx, color = tpCol, width = 2, style = line.style_dashed)
    slLbl   := label.new(openX2, slPx, "SL " + str.tostring(slPx, format.mintick), style = label.style_label_left, color = C_SL, textcolor = color.black, size = size.tiny)
    tpLbl   := label.new(openX2, tpPx, "TP " + str.tostring(tpPx, format.mintick), style = label.style_label_left, color = tpCol, textcolor = tpTxt, size = size.tiny)

// د) مد رسومات الصفقة المفتوحة مع السعر
if inTrade
    int liveX2 = bar_index + i_ext
    entryLn.set_x2(liveX2)
    slLn.set_x2(liveX2)
    tpLn.set_x2(liveX2)
    slLbl.set_x(liveX2)
    tpLbl.set_x(liveX2)

// ════════════════════════════════════════════════════════════
// 11. لوحة التحكم (HUD) — تُنشأ مرة واحدة وتُحدّث على آخر شمعة فقط
// ════════════════════════════════════════════════════════════
var table hud = table.new(position.bottom_right, 2, 13, bgcolor = color.new(#0A0E17, 20), border_width = 1, border_color = color.new(color.gray, 85))

f_row(int row, string key, string val, color valCol) =>
    table.cell(hud, 0, row, key, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(hud, 1, row, val, text_color = valCol, text_size = size.small)

if i_showHud and barstate.islast
    table.cell(hud, 0, 0, "HFJ QUANTUM", text_color = color.white, text_size = size.small, bgcolor = color.black)
    table.cell(hud, 1, 0, "V10.0", text_color = color.gray, text_size = size.small, bgcolor = color.black)

    // توقع الذكاء الاصطناعي
    string aiTxt = na(probUp) ? "—" : probUp >= probDown ? "صعود " + str.tostring(probUp, "#") + "%" : "هبوط " + str.tostring(probDown, "#") + "%"
    color  aiCol = na(probUp) ? color.gray : math.max(probUp, probDown) < i_conf ? color.gray : probUp >= probDown ? C_BULL : C_BEAR
    f_row(1, "توقع AI (kNN)", aiTxt, aiCol)
    f_row(2, "الجيران", str.tostring(nnFound) + " / " + str.tostring(i_k), color.white)
    f_row(3, "SuperTrend", stUp ? "صاعد" : "هابط", stUp ? C_BULL : C_BEAR)

    string trendTxt = trendAi == 1 ? "صاعد" : trendAi == -1 ? "هابط" : "محايد"
    color  trendCol = trendAi == 1 ? C_BULL : trendAi == -1 ? C_BEAR : color.gray
    f_row(4, "الاتجاه السريع", trendTxt, trendCol)
    f_row(5, "الزخم (RSI)", str.tostring(rsiVal, "#.0"), rsiVal > 50 ? C_BULL : C_BEAR)

    string obTxt = i_showOb ? "▲ " + str.tostring(obBullCnt) + "   ▼ " + str.tostring(obBearCnt) : "معطّل"
    f_row(6, "كتل الأوامر", obTxt, i_showOb ? color.white : color.gray)

    string orbTxt = not i_showOrb ? "معطّل" : not orbTfOk ? "فريم لحظي فقط" : inOrb ? "يتشكّل..." : not orbReady ? "—" : close > orbHi ? "فوق النطاق ▲" : close < orbLo ? "تحت النطاق ▼" : "داخل النطاق"
    color  orbCol = orbReady and close > orbHi ? C_BULL : orbReady and close < orbLo ? C_BEAR : color.gray
    f_row(7, "ORB", orbTxt, orbCol)

    string stateTxt = inTrade ? (tradeDir == 1 ? "شراء مفتوح ▲" : "بيع مفتوح ▼") : "انتظار"
    f_row(8, "الحالة", stateTxt, inTrade ? baseCol : color.gray)
    f_row(9, "الدخول", inTrade ? str.tostring(entryPx, format.mintick) : "—", color.white)
    f_row(10, "الوقف", inTrade ? str.tostring(slPx, format.mintick) : "—", C_SL)
    f_row(11, "الهدف", inTrade ? str.tostring(tpPx, format.mintick) : "—", inTrade ? baseCol : color.gray)

    int    total = wins + losses
    string wrTxt = total > 0 ? str.tostring(wins * 100.0 / total, "#.0") + "% (" + str.tostring(wins) + "/" + str.tostring(total) + ")" : "—"
    f_row(12, "نسبة النجاح", wrTxt, total > 0 and wins * 2 >= total ? C_BULL : C_BEAR)

// ════════════════════════════════════════════════════════════
// 12. التنبيهات
// ════════════════════════════════════════════════════════════
// تنبيه واحد شامل: أنشئ تنبيهاً واختر "Any alert() function call"
string tk = syminfo.ticker + " @ " + str.tostring(close, format.mintick)
if majorLong
    alert("HFJ: MAJOR LONG " + tk + " | AI " + str.tostring(probUp, "#") + "%", alert.freq_once_per_bar)
if majorShort
    alert("HFJ: MAJOR SHORT " + tk + " | AI " + str.tostring(probDown, "#") + "%", alert.freq_once_per_bar)
if orbLong
    alert("HFJ: اختراق نطاق الافتتاح ORB ▲ " + tk, alert.freq_once_per_bar)
if orbShort
    alert("HFJ: كسر نطاق الافتتاح ORB ▼ " + tk, alert.freq_once_per_bar)
if obSupportBroken
    alert("HFJ: كسر كتلة شرائية → Breaker مقاومة " + tk, alert.freq_once_per_bar)
if obResistBroken
    alert("HFJ: اختراق كتلة بيعية → Breaker دعم " + tk, alert.freq_once_per_bar)
if hitTp
    alert("HFJ: تحقق الهدف ✔ " + tk, alert.freq_once_per_bar)
if hitSl
    alert("HFJ: ضرب وقف الخسارة ✖ " + tk, alert.freq_once_per_bar)

// تنبيهات منفصلة لكل حدث
alertcondition(majorLong, "MAJOR LONG Quantum", "HFJ Quantum: إشارة شراء كبرى (SuperTrend + AI) على {{ticker}} عند {{close}}")
alertcondition(majorShort, "MAJOR SHORT Quantum", "HFJ Quantum: إشارة بيع كبرى (SuperTrend + AI) على {{ticker}} عند {{close}}")
alertcondition(orbLong, "ORB اختراق", "HFJ Quantum: اختراق نطاق الافتتاح على {{ticker}} عند {{close}}")
alertcondition(orbShort, "ORB كسر", "HFJ Quantum: كسر نطاق الافتتاح على {{ticker}} عند {{close}}")
alertcondition(obSupportBroken, "Breaker: كسر دعم", "HFJ Quantum: كسر كتلة شرائية وتحولها لمقاومة على {{ticker}}")
alertcondition(obResistBroken, "Breaker: اختراق مقاومة", "HFJ Quantum: اختراق كتلة بيعية وتحولها لدعم على {{ticker}}")
alertcondition(trigLong, "دخول شراء Quantum", "HFJ Quantum: فتح صفقة شراء على {{ticker}} عند {{close}}")
alertcondition(trigShort, "دخول بيع Quantum", "HFJ Quantum: فتح صفقة بيع على {{ticker}} عند {{close}}")
alertcondition(hitTp, "تحقق الهدف Quantum", "HFJ Quantum: تحقق الهدف على {{ticker}}")
alertcondition(hitSl, "ضرب الوقف Quantum", "HFJ Quantum: ضرب وقف الخسارة على {{ticker}}")
