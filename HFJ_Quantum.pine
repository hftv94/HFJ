// © HFJ_Quantum_Strategy_2026
// النسخة v8.5 - تتبع الصفقة حتى الهدف/الوقف + إحصائيات + إشارات بدون إعادة رسم
//@version=6
indicator("HFJ Quantum v8.5 - Live Trade Tracking", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─── المدخلات الأساسية ───
grp_ai = "محرك kNN (قائد الاتجاه)"
input_knn_len = input.int(30, "نافذة البحث", minval=2, group=grp_ai)

grp_filters = "الفلاتر"
input_rsi_len = input.int(14, "فترة RSI", group=grp_filters)
input_confirm = input.bool(true, "تأكيد الإشارة عند إغلاق الشمعة (بدون إعادة رسم)", group=grp_filters)

grp_risk = "إدارة المخاطر"
input_rrRatio    = input.float(2.0, "نسبة الهدف (R:R)", minval=0.1, step=0.1, group=grp_risk)
input_slLookback = input.int(5, "نطاق وقف الخسارة", minval=2, group=grp_risk)
input_slBuffer   = input.float(0.1, "هامش الوقف (× ATR)", minval=0.0, step=0.05, group=grp_risk)

grp_visual = "التنسيق البصري المتناسق"
input_ext     = input.int(10, "امتداد الخطوط أمام السعر (شموع)", minval=1, group=grp_visual)
input_history = input.int(3, "عدد الصفقات السابقة المحفوظة على الشارت", minval=0, maxval=50, group=grp_visual)
show_hud      = input.bool(true, "إظهار لوحة التحكم (HUD)", group=grp_visual)

// ─── لوحة ألوان "القناص الفاخرة" ───
color color_bull_laser = #00FF88 // زمردي ليزري
color color_bear_laser = #FF4400 // ياقوتي لاهب
color color_sl_line    = #FFD700 // ذهبي ملكي للوقف
color color_entry_line = color.new(color.white, 40)
color color_neut_gray  = #555555 // رمادي معدني
color color_bg_hud     = color.new(#0A0E17, 20)

// ────────────────────────────────────────────────────────────
// 1. المحركات (kNN & Filters)
// ────────────────────────────────────────────────────────────
// يُرجع 1 صاعد، -1 هابط، 0 محايد (تعادل الأصوات لم يعد ينحاز للهبوط)
f_knn_trend() =>
    int pos_count = 0
    int neg_count = 0
    float atr_val = ta.atr(10)
    for i = 1 to input_knn_len
        if math.abs(close - close[i]) < atr_val
            if close[i] > open[i]
                pos_count += 1
            else if close[i] < open[i]
                neg_count += 1
    pos_count > neg_count ? 1 : neg_count > pos_count ? -1 : 0

int trend_ai = f_knn_trend()
float rsi_val = ta.rsi(close, input_rsi_len)
float ema_fast = ta.ema(close, 9)
float atr14 = ta.atr(14) // يُحسب مرة واحدة على كل شمعة (لا يجوز استدعاء ta.* داخل if)
float raw_clv = ( (close - low) - (high - close) ) / (high - low > 0 ? high - low : 0.001)
float smoothed_clv = ta.sma(raw_clv, 3)

// ────────────────────────────────────────────────────────────
// 2. منطق الإشارات ونظام الحالة
// ────────────────────────────────────────────────────────────
bool condition_long  = (trend_ai == 1) and (close > ema_fast) and (rsi_val > 50) and (smoothed_clv > 0)
bool condition_short = (trend_ai == -1) and (close < ema_fast) and (rsi_val < 50) and (smoothed_clv < 0)
bool bar_ok = not input_confirm or barstate.isconfirmed

var int trade_state = 0
bool trigger_long  = condition_long and trade_state != 1 and bar_ok
bool trigger_short = condition_short and trade_state != -1 and bar_ok

if trigger_long
    trade_state := 1
if trigger_short
    trade_state := -1

// ────────────────────────────────────────────────────────────
// 3. التصميم البصري المتناسق (Synced Aesthetics)
// ────────────────────────────────────────────────────────────
color candle_base_col = trade_state == 1 ? color_bull_laser : trade_state == -1 ? color_bear_laser : color_neut_gray
plotcandle(open, high, low, close, title="Quantum Candles", color=candle_base_col, wickcolor=candle_base_col, bordercolor=candle_base_col)

var float track_line = close
track_line := track_line + 0.15 * (close - track_line)
float final_line = ta.wma(track_line, 5)

p_trend = plot(final_line, color=candle_base_col, linewidth=3, title="مسار الاتجاه")
p_ema   = plot(ema_fast, display=display.none)
fill(p_trend, p_ema, color = trade_state == 1 ? color.new(color_bull_laser, 90) : trade_state == -1 ? color.new(color_bear_laser, 90) : na)

// ────────────────────────────────────────────────────────────
// 4. إدارة الصفقة والخطوط (تتبع حي حتى الهدف أو الوقف)
// ────────────────────────────────────────────────────────────
float current_lowest  = ta.lowest(low, input_slLookback)
float current_highest = ta.highest(high, input_slLookback)

// حالة الصفقة المفتوحة
var bool  in_trade  = false
var int   trade_dir = 0
var float entry_px  = na
var float sl_px     = na
var float tp_px     = na
var int   entry_bar = na

// رسومات الصفقة المفتوحة
var line  entry_ln = na
var line  sl_ln    = na
var line  tp_ln    = na
var label sl_lbl   = na
var label tp_lbl   = na

// الإحصائيات
var int wins   = 0
var int losses = 0

// أرشيف رسومات الصفقات المغلقة (3 خطوط + 3 ملصقات لكل صفقة)
var line[]  old_lines  = array.new_line()
var label[] old_labels = array.new_label()

// حذف أقدم الرسومات للإبقاء على آخر (keep) صفقات فقط
f_trim_history(line[] ln_arr, label[] lb_arr, int keep) =>
    while array.size(ln_arr) > keep * 3
        line.delete(array.shift(ln_arr))
    while array.size(lb_arr) > keep * 3
        label.delete(array.shift(lb_arr))

// ─── أ) فحص ضرب الهدف/الوقف (يبدأ من الشمعة التالية للدخول) ───
bool hit_sl = false
bool hit_tp = false
if in_trade and bar_index > entry_bar
    if trade_dir == 1
        hit_sl := low <= sl_px
        hit_tp := not hit_sl and high >= tp_px
    else
        hit_sl := high >= sl_px
        hit_tp := not hit_sl and low <= tp_px
// إذا لمس السعر الوقف والهدف في نفس الشمعة نحتسبها وقفاً (افتراض متحفظ)

// إشارة معاكسة أثناء صفقة مفتوحة = خروج بسعر الإغلاق
bool is_reversal = in_trade and not (hit_sl or hit_tp) and (trigger_long or trigger_short)

// ─── ب) إغلاق الصفقة وتجميد خطوطها ───
if in_trade and (hit_sl or hit_tp or is_reversal)
    float exit_px = hit_sl ? sl_px : hit_tp ? tp_px : close
    float pnl = (exit_px - entry_px) * trade_dir
    bool is_win = pnl > 0
    if is_win
        wins += 1
    else
        losses += 1

    line.set_x2(entry_ln, bar_index)
    line.set_x2(sl_ln, bar_index)
    line.set_x2(tp_ln, bar_index)
    label.set_x(sl_lbl, bar_index)
    label.set_x(tp_lbl, bar_index)

    string res_txt = hit_tp ? "✔ TP" : hit_sl ? "✖ SL" : "⇄ " + (is_win ? "+" : "") + str.tostring(pnl, format.mintick)
    label res_lbl = label.new(bar_index, exit_px, res_txt, style=label.style_label_left, color=is_win ? color_bull_laser : color_bear_laser, textcolor=is_win ? color.black : color.white, size=size.small)

    array.push(old_lines, entry_ln)
    array.push(old_lines, sl_ln)
    array.push(old_lines, tp_ln)
    array.push(old_labels, sl_lbl)
    array.push(old_labels, tp_lbl)
    array.push(old_labels, res_lbl)
    f_trim_history(old_lines, old_labels, input_history)

    in_trade := false

// ─── ج) فتح صفقة جديدة ───
if trigger_long or trigger_short
    int dir = trigger_long ? 1 : -1
    float buffer = nz(atr14) * input_slBuffer
    float sl_raw = dir == 1 ? current_lowest - buffer : current_highest + buffer
    float risk = math.max(math.abs(close - sl_raw), syminfo.mintick) // منع وقف بمسافة صفرية

    in_trade  := true
    trade_dir := dir
    entry_px  := close
    sl_px     := close - dir * risk
    tp_px     := close + dir * risk * input_rrRatio
    entry_bar := bar_index

    color tp_col = dir == 1 ? color_bull_laser : color_bear_laser
    int x2 = bar_index + input_ext
    entry_ln := line.new(bar_index, entry_px, x2, entry_px, color=color_entry_line, width=1, style=line.style_dotted)
    sl_ln    := line.new(bar_index, sl_px, x2, sl_px, color=color_sl_line, width=2, style=line.style_dashed)
    tp_ln    := line.new(bar_index, tp_px, x2, tp_px, color=tp_col, width=2, style=line.style_dashed)
    sl_lbl   := label.new(x2, sl_px, "SL " + str.tostring(sl_px, format.mintick), style=label.style_label_left, color=color_sl_line, textcolor=color.black, size=size.tiny)
    tp_lbl   := label.new(x2, tp_px, "TP " + str.tostring(tp_px, format.mintick), style=label.style_label_left, color=tp_col, textcolor=dir == 1 ? color.black : color.white, size=size.tiny)

    if dir == 1
        label.new(bar_index, low - nz(atr14) * 0.5, "▲", color=color_bull_laser, style=label.style_label_up, textcolor=color.black, size=size.small)
    else
        label.new(bar_index, high + nz(atr14) * 0.5, "▼", color=color_bear_laser, style=label.style_label_down, textcolor=color.white, size=size.small)

// ─── د) مد خطوط الصفقة المفتوحة مع السعر ───
if in_trade
    int x2 = bar_index + input_ext
    line.set_x2(entry_ln, x2)
    line.set_x2(sl_ln, x2)
    line.set_x2(tp_ln, x2)
    label.set_x(sl_lbl, x2)
    label.set_x(tp_lbl, x2)

// ────────────────────────────────────────────────────────────
// 5. لوحة التحكم (HUD)
// ────────────────────────────────────────────────────────────
if show_hud
    var table hud = table.new(position.bottom_right, 2, 8, bgcolor=color_bg_hud, border_width=1, border_color=color.new(color.gray, 85))
    if barstate.islast
        color txt_col = color.white
        table.cell(hud, 0, 0, "HFJ QUANTUM", text_color=txt_col, text_size=size.small, bgcolor=color.new(#000000, 0))
        table.cell(hud, 1, 0, "V8.5", text_color=color.gray, text_size=size.small, bgcolor=color.new(#000000, 0))

        string trend_txt = trend_ai == 1 ? "صاعد" : trend_ai == -1 ? "هابط" : "محايد"
        color trend_col  = trend_ai == 1 ? color_bull_laser : trend_ai == -1 ? color_bear_laser : color.gray
        table.cell(hud, 0, 1, "الاتجاه", text_color=txt_col, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 1, trend_txt, text_color=trend_col, text_size=size.small)

        string rsi_txt = (rsi_val > 50 ? "صاعد " : "هابط ") + str.tostring(rsi_val, "#.0")
        table.cell(hud, 0, 2, "الزخم (RSI)", text_color=txt_col, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 2, rsi_txt, text_color=rsi_val > 50 ? color_bull_laser : color_bear_laser, text_size=size.small)

        string state_txt = in_trade ? (trade_dir == 1 ? "شراء مفتوح ▲" : "بيع مفتوح ▼") : "انتظار"
        table.cell(hud, 0, 3, "الحالة", text_color=txt_col, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 3, state_txt, text_color=in_trade ? candle_base_col : color.gray, text_size=size.small)

        table.cell(hud, 0, 4, "الدخول", text_color=txt_col, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 4, in_trade ? str.tostring(entry_px, format.mintick) : "—", text_color=txt_col, text_size=size.small)
        table.cell(hud, 0, 5, "الوقف", text_color=txt_col, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 5, in_trade ? str.tostring(sl_px, format.mintick) : "—", text_color=color_sl_line, text_size=size.small)
        table.cell(hud, 0, 6, "الهدف", text_color=txt_col, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 6, in_trade ? str.tostring(tp_px, format.mintick) : "—", text_color=candle_base_col, text_size=size.small)

        int total = wins + losses
        string wr_txt = total > 0 ? str.tostring(wins * 100.0 / total, "#.0") + "% (" + str.tostring(wins) + "/" + str.tostring(total) + ")" : "—"
        table.cell(hud, 0, 7, "نسبة النجاح", text_color=txt_col, text_size=size.small, text_halign=text.align_left)
        table.cell(hud, 1, 7, wr_txt, text_color=total > 0 and wins * 2 >= total ? color_bull_laser : color_bear_laser, text_size=size.small)

// التنبيهات
alertcondition(trigger_long, "شراء Quantum", "إشارة شراء جديدة")
alertcondition(trigger_short, "بيع Quantum", "إشارة بيع جديدة")
alertcondition(hit_tp, "تحقق الهدف Quantum", "تم الوصول إلى الهدف ✔")
alertcondition(hit_sl, "ضرب الوقف Quantum", "تم ضرب وقف الخسارة ✖")
