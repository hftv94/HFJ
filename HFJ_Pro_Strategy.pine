bool   p_sessF = input.bool(true, "Active sessions only", group = G_PRE, tooltip = "ذهب: 03:00-16:00 بتوقيت نيويورك. فوركس: 07:00-17:00 بتوقيت لندن (لندن + نيويورك). مؤشرات/عقود: 09:30-16:00 نيويورك. كريبتو و Custom: بدون فلتر")

