float s_trailR  = input.float(2.1, "", minval = 0.5, step = 0.1, inline = "s2", group = G_SIG, tooltip = "مسافة خط الوقف المتحرك بمضاعفات ATR. ينتهي الخط عند إغلاق السعر خلفه")
bool  s_levels  = input.bool(false, "TP Lines", group = G_SIG, tooltip = "رسم خطوط الدخول والوقف والهدفين عند كل إشارة")
string s_tpMode = input.string("Risk:Reward", "TP mode", options = ["ATR 50", "Stop distance (R)", "Risk:Reward"], group = G_SIG, tooltip = "ATR 50: TP1 = المعامل × ATR(50) (الأقرب للأصلي). R: المسافة من الدخول إلى وقف المحرك. Risk:Reward: وقف خلف آخر قاع/قمة، TP1 = 1R و TP2 = R:R")
float s_rr      = input.float(2.0, "R:R target", minval = 1.0, step = 0.5, group = G_SIG, tooltip = "وضع Risk:Reward فقط: الوقف خلف أدنى قاع (أو أعلى قمة) لآخر 5 شموع + 0.3 ATR، بين 0.7 و 3 ATR. TP2 = هذا الرقم × مسافة الوقف")
float s_tpAtr   = input.float(3.5, "TP1 multiple", minval = 0.1, step = 0.1, inline = "tp", group = G_SIG)
float s_tp2     = input.float(2.7, "TP2 = TP1 ×", minval = 1.0, step = 0.1, inline = "tp", group = G_SIG)
int   s_trendLen = input.int(100, "Trend MA (EMA)", minval = 10, group = G_SIG, tooltip = "علامة + تظهر عندما تكون الإشارة في نفس جهة هذا المتوسط: شراء فوقه، بيع تحته")
bool  s_trailShort = input.bool(false, "Trailing for shorts", group = G_SIG, tooltip = "افتراضياً خط الوقف المتحرك لصفقات الشراء فقط مثل المؤشر الأصلي")
string s_engine = input.string("Chandelier", "Signal engine", options = ["Chandelier", "SuperTrend"], group = G_SIG, tooltip = "Chandelier Exit هو الأقرب لإشارات الأصلي (65% على نفس الشمعة و87% ضمن 3 شموع على 15 دقيقة)")
int   s_atrLen  = input.int(22, "ATR Length", minval = 1, inline = "s3", group = G_SIG)
int   s_ceLen   = input.int(22, "Lookback", minval = 2, inline = "s3", group = G_SIG, tooltip = "فترة أعلى/أدنى إغلاق في Chandelier")
bool  s_confirm = input.bool(true, "Confirm on bar close", group = G_SIG, tooltip = "يمنع ظهور واختفاء الإشارات أثناء تكوّن الشمعة")

// --- فلتر التوافق ---
int    q_min  = input.int(3, "Min stars", minval = 0, maxval = 6, group = G_CF, tooltip = "كل إشارة تُقيَّم من 6: الاتجاه EMA، الفريم الأكبر، منطقة (سيولة/أوردر بلوك)، الزخم RMI، الدلتا، الهيكل (ADX / ORB / خط الترند). الإشارة الأقل من هذا الرقم تُرفض. 0 = كل الإشارات")
bool   q_weak = input.bool(true, "Show rejected signals (grey)", group = G_CF, tooltip = "عرض الإشارات المرفوضة بلون رمادي صغير لترى ماذا فلتر المؤشر")
string q_htf  = input.timeframe("", "Higher timeframe", group = G_CF, tooltip = "فارغ = تلقائي: 1-3د → 15د، 5-15د → 1س، 30د-1س → 4س، 4س → يومي، يومي فأعلى → أسبوعي")
int    q_zone = input.int(10, "Zone memory (bars)", minval = 1, maxval = 50, group = G_CF, tooltip = "تُحسب نقطة المنطقة إذا لمس السعر أوردر بلوك / منطقة سيولة أو حصل Sweep خلال هذا العدد من الشموع")
float  q_adx  = input.float(20, "ADX min", minval = 5, maxval = 50, group = G_CF, tooltip = "نقطة الهيكل: ADX فوق هذا الرقم مع DI في اتجاه الإشارة، أو السعر خارج ORB في اتجاهها، أو كسر خط ترند حديث")

