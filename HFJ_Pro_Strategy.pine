float  v_mult = input.float(2.0, "Spike ×", minval = 1.0, step = 0.1, group = G_VOL, tooltip = "تمييز الشمعة على الشارت إذا كان حجمها أكبر من المتوسط بهذا المعامل")
bool   v_vwap = input.bool(false, "Show VWAP", group = G_VOL)

