int   l_len   = input.int(10, "Length", minval = 2, maxval = 50, inline = "l1", group = G_LIQ, tooltip = "القمة/القاع يجب أن يكون أعلى/أدنى من هذا العدد من الشموع قبله وبعده")
int   l_max   = input.int(5,  "Max",    minval = 1, maxval = 30, inline = "l1", group = G_LIQ, tooltip = "عدد المناطق لكل جهة (قمم / قيعان). تُحذف الأبعد عن السعر أولاً")
int   l_ext   = input.int(20, "Extend", minval = 1, maxval = 100, group = G_LIQ, tooltip = "امتداد المنطقة أمام السعر (شموع)")
